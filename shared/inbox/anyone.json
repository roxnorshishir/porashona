  {
    "id": "share_1792944459618_57rri",
    "itemType": "note",
    "noteId": "mvo0ts9372o0xmf",
    "title": "editorial_project_showcase",
    "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Selected Project Showcase — Editorial Dossier</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- Google Fonts: Anton (Display), Cormorant Garamond (Italic Editorial), JetBrains Mono & Plus Jakarta Sans -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@1,400;1,500;1,600&family=JetBrains+Mono:wght@300;400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n  <style>\n    :root {\n      --bg-dark: #0a0406;\n      --bg-subtle: #120609;\n      --crimson: #e0283c;\n      --crimson-dark: #520c15;\n      --cream: #f4ece4;\n      --border-tint: rgba(224, 40, 60, 0.22);\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    body {\n      background-color: var(--bg-dark);\n      color: var(--cream);\n      font-family: 'JetBrains Mono', monospace;\n      overflow-x: hidden;\n    }\n\n    .font-condensed {\n      font-family: 'Anton', 'Bebas Neue', sans-serif;\n      line-height: 0.86;\n      letter-spacing: -0.015em;\n    }\n\n    .font-editorial {\n      font-family: 'Cormorant Garamond', serif;\n      font-style: italic;\n    }\n\n    .font-sans-ui {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    /* Radial cinematic spotlight matching Image 3 */\n    .hero-vignette {\n      background:\n        radial-gradient(circle at 70% 45%, rgba(110, 18, 28, 0.45) 0%, rgba(35, 6, 12, 0.75) 50%, #0a0406 100%),\n        radial-gradient(ellipse at 20% 60%, rgba(85, 12, 20, 0.25) 0%, transparent 60%);\n    }\n\n    /* Circular Badge Rotating Effect */\n    @keyframes slowRotate {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n    .badge-spin {\n      animation: slowRotate 24s linear infinite;\n    }\n\n    /* Screen Transition Animation */\n    .slide-exit {\n      opacity: 0;\n      transform: translateY(18px) scale(0.97);\n      transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n    .slide-enter {\n      opacity: 1;\n      transform: translateY(0) scale(1);\n      transition: all 0.38s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    /* Showcase Window styling with red glow */\n    .browser-frame {\n      background: #0f0508;\n      box-shadow: 0 35px 80px -20px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(220, 50, 70, 0.28);\n      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;\n    }\n    .browser-frame:hover {\n      box-shadow: 0 40px 90px -15px rgba(224, 40, 60, 0.25), 0 0 0 1px rgba(224, 40, 60, 0.5);\n    }\n\n    /* Vertical Casefile text on the far left */\n    .vertical-title {\n      writing-mode: vertical-rl;\n      transform: rotate(180deg);\n    }\n\n    /* Viewfinder corner brackets */\n    .corner-bracket {\n      width: 14px;\n      height: 14px;\n      position: absolute;\n      pointer-events: none;\n    }\n    .corner-tl { top: -6px; left: -6px; border-top: 1.5px solid rgba(244, 236, 228, 0.4); border-left: 1.5px solid rgba(244, 236, 228, 0.4); }\n    .corner-br { bottom: -6px; right: -6px; border-bottom: 1.5px solid rgba(244, 236, 228, 0.4); border-right: 1.5px solid rgba(244, 236, 228, 0.4); }\n  </style>\n</head>\n<body class=\"relative min-h-screen w-full flex flex-col justify-between selection:bg-[#e0283c] selection:text-white\">\n\n  <!-- Background Lighting & Ambient Textures -->\n  <div class=\"fixed inset-0 hero-vignette pointer-events-none z-0\"></div>\n  <div class=\"fixed inset-0 bg-[radial-gradient(rgba(244,236,228,0.04)_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none z-0 opacity-40\"></div>\n\n  <!-- Left Vertical Spine Archive Tag -->\n  <aside class=\"hidden xl:flex fixed left-4 top-1/2 -translate-y-1/2 z-20 vertical-title text-[9px] tracking-[0.3em] text-[#d64756]/60 uppercase font-mono pointer-events-none select-none\">\n    <span id=\"verticalArchiveTag\">ARCHIVE NO. 001 // VISUAL CASEFILE</span>\n  </aside>\n\n  <!-- ================= TOP STATUS BAR ================= -->\n  <header class=\"relative z-20 w-full px-6 sm:px-12 pt-6 sm:pt-8 flex items-center justify-between\">\n    <!-- Client Counter Indicator -->\n    <div class=\"flex items-center space-x-2 text-[11px] tracking-[0.24em] font-mono uppercase text-[#e2d6cc]\">\n      <span class=\"text-white/40\">CLIENT</span>\n      <span id=\"clientNumber\" class=\"text-white font-bold bg-white/10 px-1.5 py-0.5 rounded\">001</span>\n      <span class=\"text-red-500/70\">/</span>\n      <span id=\"clientTypeTag\" class=\"text-red-400/90 font-medium\">FEATURED</span>\n    </div>\n\n    <!-- Live Website Red Pulse -->\n    <div class=\"flex items-center space-x-2.5\">\n      <span class=\"w-2 h-2 rounded-full bg-[#ff3344] shadow-[0_0_8px_#ff3344] animate-pulse\"></span>\n      <span class=\"text-[10px] sm:text-[11px] font-semibold tracking-[0.25em] text-[#ff707e] uppercase font-mono\">\n        LIVE WEBSITE\n      </span>\n    </div>\n  </header>\n\n  <!-- ================= MAIN SHOWCASE STAGE ================= -->\n  <main class=\"relative z-20 flex-1 max-w-[1580px] mx-auto w-full px-6 sm:px-12 py-6 lg:py-10 flex items-center\">\n    <div class=\"w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center\">\n\n      <!-- ================= LEFT COLUMN: EDITORIAL DOSSIER ================= -->\n      <section class=\"lg:col-span-5 flex flex-col justify-center space-y-6 lg:pr-4\" id=\"dossierContainer\">\n        \n        <!-- Category Pill Subheader -->\n        <div class=\"text-[9px] sm:text-[10px] tracking-[0.28em] text-[#d64756] font-mono uppercase font-semibold flex items-center gap-2\">\n          <span id=\"clientSubCategory\">CLIENT WORK // INDEPENDENT IDENTITY</span>\n        </div>\n\n        <!-- Giant Headline Typo (Top Cream, Bottom Crimson) -->\n        <div class=\"space-y-0 select-none\">\n          <h1 id=\"titleLine1\" class=\"font-condensed text-[18vw] sm:text-[13vw] lg:text-[7.6vw] leading-[0.84] text-[#f4ece4] transition-all duration-300\">\n            SICKO\n          </h1>\n          <h1 id=\"titleLine2\" class=\"font-condensed text-[18vw] sm:text-[13vw] lg:text-[7.6vw] leading-[0.84] text-[#d82436] transition-all duration-300\">\n            SOUL.\n          </h1>\n        </div>\n\n        <!-- Thin divider line -->\n        <div class=\"w-20 h-[2px] bg-[#d82436]/60\"></div>\n\n        <!-- Editorial Subhead (Italic Serif) -->\n        <h2 id=\"editorialSubhead\" class=\"font-editorial text-2xl sm:text-3xl lg:text-4xl text-[#ebdcd0] leading-snug\">\n          A different kind of presence.\n        </h2>\n\n        <!-- Description -->\n        <p id=\"projectBio\" class=\"font-sans-ui text-sm sm:text-base text-[#b8a79d] font-normal leading-relaxed max-w-lg\">\n          A bold digital storefront for a streetwear identity that refuses to blend into the background. The visual language is unapologetically dark, graphic, and expressive.\n        </p>\n\n        <!-- Technical Specification Table (Exact UI from screenshot) -->\n        <div class=\"border-t border-b border-red-950/60 divide-y divide-red-950/50 text-[11px] font-mono py-1 max-w-lg\">\n          <div class=\"py-2.5 flex justify-between items-center\">\n            <span class=\"text-white/40 tracking-wider uppercase text-[10px]\">THE CLIENT</span>\n            <span id=\"specClient\" class=\"text-[#eddcd0] font-medium text-right\">Independent streetwear label</span>\n          </div>\n          <div class=\"py-2.5 flex justify-between items-center\">\n            <span class=\"text-white/40 tracking-wider uppercase text-[10px]\">THE MEDIUM</span>\n            <span id=\"specMedium\" class=\"text-[#eddcd0] font-medium text-right\">Web experience</span>\n          </div>\n          <div class=\"py-2.5 flex justify-between items-center\">\n            <span class=\"text-white/40 tracking-wider uppercase text-[10px]\">THE DIRECTION</span>\n            <span id=\"specDirection\" class=\"text-[#eddcd0] font-medium text-right\">Dark / graphic / editorial</span>\n          </div>\n        </div>\n\n        <!-- Action Buttons -->\n        <div class=\"flex flex-wrap items-center gap-3 pt-2\">\n          <a id=\"btnLiveSite\" href=\"#\" target=\"_blank\" class=\"px-5 sm:px-6 py-3 rounded bg-[#d82436] hover:bg-[#b51727] text-white text-xs font-mono tracking-widest uppercase font-semibold transition-all shadow-[0_0_20px_rgba(216,36,54,0.35)] flex items-center gap-2 group\">\n            <span>VISIT LIVE WEBSITE</span>\n            <span class=\"group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform\">↗</span>\n          </a>\n          <button id=\"btnInspectWork\" class=\"px-5 sm:px-6 py-3 rounded border border-white/20 hover:border-red-400 hover:text-white text-[#d4c3b8] text-xs font-mono tracking-widest uppercase transition-all bg-black/40 flex items-center gap-2\">\n            <span>INSPECT THE WORK</span>\n            <span class=\"text-red-400\">⊕</span>\n          </button>\n        </div>\n\n      </section>\n\n      <!-- ================= RIGHT COLUMN: INTERACTIVE BROWSER SHOWCASE ================= -->\n      <section class=\"lg:col-span-7 relative flex justify-center items-center\">\n        \n        <!-- Viewfinder Outer Editorial Brackets -->\n        <div class=\"corner-bracket corner-tl hidden sm:block\"></div>\n        <div class=\"corner-bracket corner-br hidden sm:block\"></div>\n\n        <!-- Floating Circular Badge \"IN THE WILD.\" (Top Right of Banner) -->\n        <div class=\"absolute -top-7 -right-4 sm:-top-9 sm:-right-6 z-30 pointer-events-none select-none\">\n          <div class=\"relative w-24 h-24 sm:w-28 sm:h-28 rounded-full border border-red-500/40 bg-[#16060a]/90 backdrop-blur-md flex flex-col items-center justify-center p-2 text-center shadow-[0_0_25px_rgba(224,40,60,0.25)]\">\n            <span class=\"text-[11px] sm:text-xs font-condensed tracking-wider text-[#f5eee6] leading-none uppercase font-bold\">IN THE</span>\n            <span class=\"text-[12px] sm:text-sm font-condensed tracking-wider text-[#d82436] leading-none uppercase font-bold\">WILD.</span>\n            <div class=\"w-6 h-[1px] bg-red-500/50 my-1\"></div>\n            <span id=\"badgeLiveCount\" class=\"text-[9px] tracking-widest text-[#ebd9cc]/70 font-mono\">LIVE / 001</span>\n          </div>\n        </div>\n\n        <!-- Main Browser Mockup Container -->\n        <div id=\"browserCard\" class=\"browser-frame w-full rounded-lg border border-red-900/40 overflow-hidden relative group\">\n          \n          <!-- Top Window Chrome / URL Bar -->\n          <div class=\"bg-[#14060a] px-4 py-2.5 flex items-center justify-between border-b border-red-950/60 select-none\">\n            <!-- 3 Dots -->\n            <div class=\"flex items-center space-x-1.5\">\n              <span class=\"w-2.5 h-2.5 rounded-full bg-red-900/60 inline-block\"></span>\n              <span class=\"w-2.5 h-2.5 rounded-full bg-red-900/40 inline-block\"></span>\n              <span class=\"w-2.5 h-2.5 rounded-full bg-red-900/40 inline-block\"></span>\n            </div>\n            <!-- Centered Domain -->\n            <div id=\"browserUrl\" class=\"text-[11px] tracking-wider text-red-300/80 font-mono font-medium truncate px-2\">\n              sickosoul.shop\n            </div>\n            <!-- Right Counter -->\n            <div class=\"text-[10px] tracking-widest text-white/30 font-mono\">\n              <span id=\"browserShowcaseIndex\">01</span> / SHOWCASE\n            </div>\n          </div>\n\n          <!-- Inside Viewport (Simulating high impact dark website showcase) -->\n          <div id=\"viewportCanvas\" class=\"relative w-full aspect-[16/10] bg-[#080204] overflow-hidden flex flex-col justify-between p-4 sm:p-7 cursor-pointer transition-all\">\n            \n            <!-- Dynamic Background Artwork Simulation -->\n            <div id=\"bannerArtBg\" class=\"absolute inset-0 bg-cover bg-center transition-all duration-700 brightness-[0.78] contrast-125\" style=\"background-image: url('https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=1200&q=80');\">\n            </div>\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#0a0306] via-[#0a0306]/40 to-transparent\"></div>\n            <div class=\"absolute inset-0 bg-gradient-to-r from-[#0a0306]/80 via-transparent to-[#0a0306]/90\"></div>\n\n            <!-- Viewport Internal Content Overlay -->\n            <div class=\"relative z-10 flex justify-between items-start\">\n              <div class=\"text-[9px] font-mono tracking-[0.2em] text-red-300/80 bg-black/60 px-2 py-1 rounded border border-red-950\">\n                PROD // VER 4.0 // PRODUCTION\n              </div>\n              <div class=\"px-2 py-1 rounded bg-black/60 border border-white/10 text-[9px] font-mono text-white/60\">\n                SOUND: OFF 🔈\n              </div>\n            </div>\n\n            <!-- Central Bold Slogan Text (Graphic Brutalist Vibe) -->\n            <div class=\"relative z-10 space-y-1.5 my-auto max-w-md\">\n              <div id=\"bannerSloganTag\" class=\"text-[10px] sm:text-xs font-condensed tracking-[0.18em] text-[#d82436] uppercase font-semibold\">\n                WE CAME UP IN THE BLIND SPOT\n              </div>\n              <div id=\"bannerSloganQuote\" class=\"font-sans-ui text-xs sm:text-sm text-[#f0e4d7] font-medium leading-relaxed drop-shadow-md\">\n                \"It started on a stairwell. Nobody swept. Hoods up, faces gone, nothing to prove to whoever was above ground.\"\n              </div>\n              <div id=\"bannerPunchline\" class=\"font-condensed text-xl sm:text-2xl lg:text-3xl text-white tracking-wide uppercase pt-1\">\n                WE WERE NEVER LET IN. WE TOOK THE DOOR OFF.\n              </div>\n            </div>\n\n            <!-- Bottom Action Banner Strip -->\n            <div class=\"relative z-10 flex items-center justify-between border-t border-white/10 pt-3\">\n              <div class=\"flex items-center space-x-2 text-[10px] sm:text-[11px] font-mono tracking-[0.2em] text-[#ebdcd0] group-hover:text-red-400 transition-colors uppercase font-medium\">\n                <span>OPEN THE VISUAL FILE</span>\n                <span class=\"text-xs\">↗</span>\n              </div>\n              <div class=\"text-[10px] font-mono text-white/40\">\n                CLICK TO EXPAND\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </section>\n\n    </div>\n  </main>\n\n  <!-- ================= FLOATING RIGHT-HAND ARROW CONTROLS ================= -->\n  <!-- Direct requested feature: Seamlessly change project and banner -->\n  <aside class=\"fixed right-6 sm:right-10 bottom-24 sm:bottom-28 z-50 flex items-center space-x-2 bg-[#140609]/90 p-1.5 rounded-full border border-red-900/50 backdrop-blur-md shadow-[0_10px_30px_rgba(0,0,0,0.8)]\">\n    <button id=\"prevBtn\" aria-label=\"Previous Project\" class=\"w-10 h-10 rounded-full flex items-center justify-center text-white/70 hover:text-white hover:bg-red-950/60 transition-all border border-transparent hover:border-red-500/40 cursor-pointer\">\n      <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 19l-7-7 7-7\" />\n      </svg>\n    </button>\n\n    <div class=\"px-2 text-[10px] font-mono tracking-widest text-red-300/80\">\n      <span id=\"navCurrent\">01</span><span class=\"text-white/20 mx-1\">/</span><span id=\"navTotal\">04</span>\n    </div>\n\n    <button id=\"nextBtn\" aria-label=\"Next Project\" class=\"w-10 h-10 rounded-full flex items-center justify-center text-white hover:text-white bg-[#d82436] hover:bg-[#ff3344] transition-all shadow-[0_0_15px_rgba(216,36,54,0.45)] cursor-pointer\">\n      <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 5l7 7-7 7\" />\n      </svg>\n    </button>\n  </aside>\n\n  <!-- ================= BOTTOM EDITORIAL FOOTER ================= -->\n  <footer class=\"relative z-20 w-full px-6 sm:px-12 py-5 flex flex-wrap items-center justify-between text-[10px] font-mono tracking-widest text-white/40 border-t border-red-950/30 bg-gradient-to-t from-[#0a0406] to-transparent\">\n    <div id=\"footerDomain\" class=\"text-red-400/80 uppercase\">\n      WWW.SICKOSOUL.SHOP\n    </div>\n\n    <div class=\"flex items-center space-x-3\">\n      <span>VIEW THE EVIDENCE</span>\n      <span class=\"text-red-500\">/</span>\n      <span id=\"footerCount\">01</span>\n    </div>\n\n    <div class=\"hidden md:block uppercase tracking-[0.2em] text-[#d6c7bc]/60\">\n      THE WEB, WITH TEETH. <span class=\"text-red-500/50\">/</span> AN IDENTITY THAT DOESN'T ASK PERMISSION.\n    </div>\n  </footer>\n\n  <!-- ================= MODAL: FULLSCREEN FILE INSPECTION ================= -->\n  <div id=\"fileModal\" class=\"fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-4 sm:p-8 transition-opacity duration-300 opacity-0\">\n    <div class=\"relative max-w-4xl w-full bg-[#120508] border border-red-900/60 rounded-xl overflow-hidden shadow-2xl flex flex-col\">\n      <div class=\"px-5 py-3.5 bg-[#1a070c] border-b border-red-950/60 flex items-center justify-between\">\n        <div class=\"text-xs font-mono tracking-widest text-[#ebd9cc] flex items-center gap-2\">\n          <span class=\"w-2 h-2 rounded-full bg-red-500\"></span>\n          <span id=\"modalTitle\">PROJECT ASSET ARCHIVE</span>\n        </div>\n        <button id=\"modalCloseBtn\" class=\"text-white/50 hover:text-white font-mono text-sm px-2 py-0.5 rounded border border-white/10 hover:border-red-500 transition\">\n          ESC / CLOSE ✕\n        </button>\n      </div>\n      <div class=\"p-6 sm:p-8 space-y-5 overflow-y-auto max-h-[80vh]\">\n        <img id=\"modalImage\" src=\"\" alt=\"Project Visual Preview\" class=\"w-full h-80 sm:h-96 object-cover rounded-lg border border-red-950 shadow-inner\">\n        <div class=\"space-y-2\">\n          <h3 id=\"modalHeading\" class=\"font-condensed text-3xl text-white tracking-wide\"></h3>\n          <p id=\"modalDescription\" class=\"font-sans-ui text-sm text-[#c4b5aa] leading-relaxed\"></p>\n        </div>\n        <div class=\"pt-2 flex justify-end\">\n          <a id=\"modalExternalLink\" href=\"#\" target=\"_blank\" class=\"px-5 py-2.5 bg-[#d82436] hover:bg-red-600 text-white font-mono text-xs tracking-wider rounded uppercase font-semibold\">\n            Launch Official Case Study ↗\n          </a>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ================= DATA & CONTROLLER SCRIPT ================= -->\n  <script>\n    // -------------------------------------------------------------\n    // Curated Projects Data Array\n    // -------------------------------------------------------------\n    const projects = [\n      {\n        id: \"001\",\n        number: \"001\",\n        typeTag: \"FEATURED\",\n        subCategory: \"CLIENT WORK // INDEPENDENT IDENTITY\",\n        titleLine1: \"SICKO\",\n        titleLine2: \"SOUL.\",\n        editorialSubhead: \"A different kind of presence.\",\n        bio: \"A bold digital storefront for a streetwear identity that refuses to blend into the background. The visual language is unapologetically dark, graphic, and expressive.\",\n        specs: {\n          client: \"Independent streetwear label\",\n          medium: \"Web experience\",\n          direction: \"Dark / graphic / editorial\"\n        },\n        urlDisplay: \"sickosoul.shop\",\n        footerDomain: \"WWW.SICKOSOUL.SHOP\",\n        liveUrl: \"https://sickosoul.shop\",\n        bgImage: \"https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=1200&q=80\",\n        sloganTag: \"WE CAME UP IN THE BLIND SPOT\",\n        sloganQuote: '\"It started on a stairwell. Nobody swept. Hoods up, faces gone, nothing to prove to whoever was above ground.\"',\n        punchline: \"WE WERE NEVER LET IN. WE TOOK THE DOOR OFF.\"\n      },\n      {\n        id: \"002\",\n        number: \"002\",\n        typeTag: \"GEOSPATIAL\",\n        subCategory: \"AI PLATFORM // ACCIDENT PREVENTION\",\n        titleLine1: \"SAFE\",\n        titleLine2: \"PATH BD.\",\n        editorialSubhead: \"Mapping the margin of human error.\",\n        bio: \"Next-generation highway hazard tracking for dense transport arteries. Harnesses edge-processed computer vision and community black-spot data to cut transit casualties.\",\n        specs: {\n          client: \"National Transit Initiative\",\n          medium: \"Geospatial Dashboard & Telemetry\",\n          direction: \"High-density / Tactical / Radar\"\n        },\n        urlDisplay: \"safepath.io/dhaka-corridor\",\n        footerDomain: \"WWW.SAFEPATH.IO\",\n        liveUrl: \"https://safepath.io\",\n        bgImage: \"https://images.unsplash.com/photo-1519501025264-65ba15a82390?auto=format&fit=crop&w=1200&q=80\",\n        sloganTag: \"ZERO COLLISION TOLERANCE\",\n        sloganQuote: '\"Every curve and intersection has a memory of impact. We translate road friction and velocity data into proactive survival corridors.\"',\n        punchline: \"SEE THE ACCIDENT BEFORE IT EVEN GATHERS SPEED.\"\n      },\n      {\n        id: \"003\",\n        number: \"003\",\n        typeTag: \"MOBILITY\",\n        subCategory: \"URBAN COMMUTE // DYNAMIC ROUTING\",\n        titleLine1: \"RIDE\",\n        titleLine2: \"SPLIT.\",\n        editorialSubhead: \"Synchronized transit for dense metropolises.\",\n        bio: \"An algorithm-driven micro-carpooling architecture designed to slash city travel expenses by 42% while untangling severe peak-hour bottlenecks.\",\n        specs: {\n          client: \"Ridesplit Technologies Ltd.\",\n          medium: \"Cross-platform Mobile & Engine\",\n          direction: \"Minimalist / Cyber / Kinetic\"\n        },\n        urlDisplay: \"ridesplit.app/experience\",\n        footerDomain: \"WWW.RIDESPLIT.APP\",\n        liveUrl: \"https://ridesplit.app\",\n        bgImage: \"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=80\",\n        sloganTag: \"SHARED KINETIC ARCHITECTURE\",\n        sloganQuote: '\"Crowded urban centers shouldn\\'t mean trapped time. Shared velocity creates exponential urban freedom without extra pavement.\"',\n        punchline: \"THREE PASSENGERS. ONE UNIFIED VECTOR.\"\n      },\n      {\n        id: \"004\",\n        number: \"004\",\n        typeTag: \"LABS / EXPERIMENT\",\n        subCategory: \"AUDIO-VISUAL // GENERATIVE CORE\",\n        titleLine1: \"VOID\",\n        titleLine2: \"RUNNER.\",\n        editorialSubhead: \"Synthesizing sound into pure digital topography.\",\n        bio: \"A WebGL audiovisual benchmark exploring real-time polyphonic frequency distortion and brutalist 3D spatial typography.\",\n        specs: {\n          client: \"Independent Sound Lab\",\n          medium: \"Interactive WebGL Exhibition\",\n          direction: \"Experimental / Sound Reactive\"\n        },\n        urlDisplay: \"voidrunner.studio/v3\",\n        footerDomain: \"WWW.VOIDRUNNER.STUDIO\",\n        liveUrl: \"https://voidrunner.studio\",\n        bgImage: \"https://images.unsplash.com/photo-1550684848-fac1c5b4e853?auto=format&fit=crop&w=1200&q=80\",\n        sloganTag: \"EXPERIMENTAL FREQUENCY DISSOLVE\",\n        sloganQuote: '\"Sound does not belong in two dimensions. We sculpt physical waveforms into responsive, architectural light chambers.\"',\n        punchline: \"LISTEN WITH YOUR RETINAS.\"\n      }\n    ];\n\n    let currentIndex = 0;\n\n    // DOM Elements\n    const clientNumber = document.getElementById('clientNumber');\n    const clientTypeTag = document.getElementById('clientTypeTag');\n    const clientSubCategory = document.getElementById('clientSubCategory');\n    const titleLine1 = document.getElementById('titleLine1');\n    const titleLine2 = document.getElementById('titleLine2');\n    const editorialSubhead = document.getElementById('editorialSubhead');\n    const projectBio = document.getElementById('projectBio');\n    const specClient = document.getElementById('specClient');\n    const specMedium = document.getElementById('specMedium');\n    const specDirection = document.getElementById('specDirection');\n    const btnLiveSite = document.getElementById('btnLiveSite');\n    const browserUrl = document.getElementById('browserUrl');\n    const browserShowcaseIndex = document.getElementById('browserShowcaseIndex');\n    const bannerArtBg = document.getElementById('bannerArtBg');\n    const bannerSloganTag = document.getElementById('bannerSloganTag');\n    const bannerSloganQuote = document.getElementById('bannerSloganQuote');\n    const bannerPunchline = document.getElementById('bannerPunchline');\n    const badgeLiveCount = document.getElementById('badgeLiveCount');\n    const verticalArchiveTag = document.getElementById('verticalArchiveTag');\n    const footerDomain = document.getElementById('footerDomain');\n    const footerCount = document.getElementById('footerCount');\n    const navCurrent = document.getElementById('navCurrent');\n    const navTotal = document.getElementById('navTotal');\n\n    const prevBtn = document.getElementById('prevBtn');\n    const nextBtn = document.getElementById('nextBtn');\n    const browserCard = document.getElementById('browserCard');\n    const viewportCanvas = document.getElementById('viewportCanvas');\n    const btnInspectWork = document.getElementById('btnInspectWork');\n\n    // Modal Elements\n    const fileModal = document.getElementById('fileModal');\n    const modalCloseBtn = document.getElementById('modalCloseBtn');\n    const modalImage = document.getElementById('modalImage');\n    const modalHeading = document.getElementById('modalHeading');\n    const modalDescription = document.getElementById('modalDescription');\n    const modalExternalLink = document.getElementById('modalExternalLink');\n    const modalTitle = document.getElementById('modalTitle');\n\n    // Initialize total count\n    navTotal.textContent = String(projects.length).padStart(2, '0');\n\n    // -------------------------------------------------------------\n    // Smooth Transition Engine\n    // -------------------------------------------------------------\n    function updateProject(index, direction = 'next') {\n      const p = projects[index];\n\n      // Subtle exit animation\n      titleLine1.style.opacity = '0';\n      titleLine1.style.transform = direction === 'next' ? 'translateY(-14px)' : 'translateY(14px)';\n      titleLine2.style.opacity = '0';\n      titleLine2.style.transform = direction === 'next' ? 'translateY(14px)' : 'translateY(-14px)';\n      \n      browserCard.style.transform = direction === 'next' ? 'scale(0.96) translateX(12px)' : 'scale(0.96) translateX(-12px)';\n      browserCard.style.opacity = '0.5';\n\n      setTimeout(() => {\n        // Update dossier text\n        clientNumber.textContent = p.number;\n        clientTypeTag.textContent = p.typeTag;\n        clientSubCategory.textContent = p.subCategory;\n        titleLine1.textContent = p.titleLine1;\n        titleLine2.textContent = p.titleLine2;\n        editorialSubhead.textContent = p.editorialSubhead;\n        projectBio.textContent = p.bio;\n\n        // Specs\n        specClient.textContent = p.specs.client;\n        specMedium.textContent = p.specs.medium;\n        specDirection.textContent = p.specs.direction;\n\n        // Links & Browser\n        btnLiveSite.href = p.liveUrl;\n        browserUrl.textContent = p.urlDisplay;\n        browserShowcaseIndex.textContent = p.number;\n        bannerArtBg.style.backgroundImage = `url('${p.bgImage}')`;\n        bannerSloganTag.textContent = p.sloganTag;\n        bannerSloganQuote.textContent = p.sloganQuote;\n        bannerPunchline.textContent = p.punchline;\n\n        // Peripheral badges\n        badgeLiveCount.textContent = `LIVE / ${p.number}`;\n        verticalArchiveTag.textContent = `ARCHIVE NO. ${p.number} // VISUAL CASEFILE`;\n        footerDomain.textContent = p.footerDomain;\n        footerCount.textContent = p.number;\n        navCurrent.textContent = p.number;\n\n        // Reset transforms with entrance easing\n        titleLine1.style.opacity = '1';\n        titleLine1.style.transform = 'translateY(0)';\n        titleLine2.style.opacity = '1';\n        titleLine2.style.transform = 'translateY(0)';\n\n        browserCard.style.transform = 'scale(1) translateX(0)';\n        browserCard.style.opacity = '1';\n      }, 200);\n    }\n\n    // -------------------------------------------------------------\n    // Next / Prev Handlers\n    // -------------------------------------------------------------\n    function nextProject() {\n      currentIndex = (currentIndex + 1) % projects.length;\n      updateProject(currentIndex, 'next');\n    }\n\n    function prevProject() {\n      currentIndex = (currentIndex - 1 + projects.length) % projects.length;\n      updateProject(currentIndex, 'prev');\n    }\n\n    nextBtn.addEventListener('click', nextProject);\n    prevBtn.addEventListener('click', prevProject);\n\n    // Keyboard Arrow navigation\n    window.addEventListener('keydown', (e) => {\n      if (e.key === 'ArrowRight') nextProject();\n      if (e.key === 'ArrowLeft') prevProject();\n      if (e.key === 'Escape') closeModal();\n    });\n\n    // -------------------------------------------------------------\n    // Fullscreen Case Inspection Modal\n    // -------------------------------------------------------------\n    function openModal() {\n      const p = projects[currentIndex];\n      modalImage.src = p.bgImage;\n      modalHeading.textContent = `${p.titleLine1} ${p.titleLine2}`;\n      modalDescription.textContent = `${p.editorialSubhead} — ${p.bio}`;\n      modalExternalLink.href = p.liveUrl;\n      modalTitle.textContent = `CASEFILE ARCHIVE // ${p.id} — ${p.specs.client}`;\n\n      fileModal.classList.remove('hidden');\n      fileModal.classList.add('flex');\n      setTimeout(() => {\n        fileModal.style.opacity = '1';\n      }, 10);\n    }\n\n    function closeModal() {\n      fileModal.style.opacity = '0';\n      setTimeout(() => {\n        fileModal.classList.add('hidden');\n        fileModal.classList.remove('flex');\n      }, 300);\n    }\n\n    viewportCanvas.addEventListener('click', openModal);\n    btnInspectWork.addEventListener('click', openModal);\n    modalCloseBtn.addEventListener('click', closeModal);\n    fileModal.addEventListener('click', (e) => {\n      if (e.target === fileModal) closeModal();\n    });\n\n    // Initial render\n    updateProject(0);\n  </script>\n</body>\n</html>",
