  "content": "<!DOCTYPE html>\n<html lang=\"bn\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Windows User & Single App Kiosk Setup Guide</title>\n    <style>\n        :root {\n            --bg-color: #f4f7f9;\n            --card-bg: #ffffff;\n            --primary: #2563eb;\n            --primary-hover: #1d4ed8;\n            --text-main: #1e293b;\n            --text-muted: #64748b;\n            --code-bg: #0f172a;\n            --code-text: #e2e8f0;\n            --border-color: #e2e8f0;\n            --badge-cmd: #059669;\n            --badge-ui: #d97706;\n        }\n\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n            background-color: var(--bg-color);\n            color: var(--text-main);\n            line-height: 1.6;\n            padding: 20px;\n        }\n\n        .container {\n            max-width: 850px;\n            margin: 0 auto;\n        }\n\n        header {\n            text-align: center;\n            margin-bottom: 24px;\n            padding: 20px;\n            background: var(--card-bg);\n            border-radius: 12px;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.04);\n            border: 1px solid var(--border-color);\n        }\n\n        header h1 {\n            font-size: 1.55rem;\n            color: var(--text-main);\n            margin-bottom: 6px;\n        }\n\n        header p {\n            color: var(--text-muted);\n            font-size: 0.95rem;\n        }\n\n        .step-card {\n            background: var(--card-bg);\n            border-radius: 12px;\n            padding: 20px 24px;\n            margin-bottom: 18px;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.04);\n            border: 1px solid var(--border-color);\n        }\n\n        .step-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 12px;\n            flex-wrap: wrap;\n            gap: 10px;\n        }\n\n        .step-title {\n            font-size: 1.12rem;\n            font-weight: 600;\n            color: var(--text-main);\n        }\n\n        .badge {\n            font-size: 0.78rem;\n            font-weight: 600;\n            padding: 4px 10px;\n            border-radius: 20px;\n            color: #fff;\n            letter-spacing: 0.3px;\n        }\n\n        .badge-cmd { background-color: var(--badge-cmd); }\n        .badge-ui { background-color: var(--badge-ui); }\n\n        .action-note {\n            font-size: 0.92rem;\n            color: #334155;\n            margin-bottom: 12px;\n            background: #f8fafc;\n            padding: 8px 12px;\n            border-left: 3px solid var(--primary);\n            border-radius: 4px;\n        }\n\n        .code-box {\n            position: relative;\n            background: var(--code-bg);\n            color: var(--code-text);\n            padding: 12px 16px;\n            border-radius: 8px;\n            font-family: 'Consolas', 'Courier New', monospace;\n            font-size: 0.9rem;\n            overflow-x: auto;\n            margin-top: 8px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            gap: 12px;\n        }\n\n        .code-box code {\n            white-space: pre-wrap;\n            word-break: break-all;\n        }\n\n        .copy-btn {\n            background: rgba(255, 255, 255, 0.12);\n            color: #fff;\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            padding: 6px 12px;\n            border-radius: 6px;\n            font-size: 0.8rem;\n            cursor: pointer;\n            white-space: nowrap;\n            transition: all 0.2s;\n        }\n\n        .copy-btn:hover {\n            background: var(--primary);\n            border-color: var(--primary);\n        }\n\n        .copy-btn.copied {\n            background: #10b981;\n            border-color: #10b981;\n        }\n\n        .sub-list {\n            list-style: none;\n            padding-left: 4px;\n        }\n\n        .sub-list li {\n            margin-bottom: 8px;\n            font-size: 0.95rem;\n        }\n\n        .highlight {\n            background: #fef08a;\n            color: #854d0e;\n            padding: 1px 5px;\n            border-radius: 4px;\n            font-family: monospace;\n            font-weight: bold;\n        }\n\n        .divider {\n            border: 0;\n            height: 1px;\n            background: var(--border-color);\n            margin: 14px 0;\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"container\">\n    <header>\n        <h1>Windows Standard User & Single App Access Guide</h1>\n        <p>কোনো কনফিউশন ছাড়া সরাসরি কপি-পেস্ট চিটশিট (Windows 10 / 11 Home & Pro)</p>\n    </header>\n\n    <!-- STEP 1 -->\n    <div class=\"step-card\">\n        <div class=\"step-header\">\n            <span class=\"step-title\">১. নতুন স্ট্যান্ডার্ড ইউজার তৈরি ও পাসওয়ার্ড সেট করা</span>\n            <span class=\"badge badge-cmd\">CMD (Run as Administrator)</span>\n        </div>\n        <div class=\"action-note\">Start মেনুতে <b>cmd</b> লিখে রাইট-ক্লিক করে <b>Run as administrator</b> ওপেন করুন। (<span class=\"highlight\">Family</span> এর জায়গায় ইউজারের নাম দিন)</div>\n        \n        <p style=\"font-size: 0.9rem; margin-bottom: 4px;\"><b>পাসওয়ার্ড ছাড়া ইউজার বানাতে:</b></p>\n        <div class=\"code-box\">\n            <code>net user Family /add</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n\n        <hr class=\"divider\">\n\n        <p style=\"font-size: 0.9rem; margin-bottom: 4px;\"><b>পাসওয়ার্ডসহ ইউজার বানাতে বা পাসওয়ার্ড পরিবর্তন করতে:</b></p>\n        <div class=\"code-box\">\n            <code>net user Family 123456 /add</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n        <div class=\"code-box\">\n            <code>net user Family NewPassword123</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n    </div>\n\n    <!-- STEP 2 -->\n    <div class=\"step-card\">\n        <div class=\"step-header\">\n            <span class=\"step-title\">২. ইউজার প্রোফাইল ফোল্ডার তৈরি করা (আবশ্যিক)</span>\n            <span class=\"badge badge-ui\">Windows Sign-In</span>\n        </div>\n        <ul class=\"sub-list\">\n            <li>১. Start মেনু থেকে নতুন তৈরি করা <b>Family</b> ইউজারে একবার লগইন (Sign in) করুন।</li>\n            <li>২. ডেস্কটপ চলে আসলে সাথে সাথে <b>Sign out</b> করে আবার মূল <b>Administrator</b> অ্যাকাউন্টে ফিরুন।</li>\n            <li>৩. পিসি একবার <b>Restart</b> দিন (যাতে ব্যাকগ্রাউন্ডে ফাইল লক না থাকে)।</li>\n        </ul>\n    </div>\n\n    <!-- STEP 3 -->\n    <div class=\"step-card\">\n        <div class=\"step-header\">\n            <span class=\"step-title\">৩. ইউজারের ফোল্ডার নেম ও SID চেক করা</span>\n            <span class=\"badge badge-cmd\">CMD (Run as Administrator)</span>\n        </div>\n        <div class=\"action-note\">Admin CMD ওপেন করে ইউজারের ফোল্ডারের সঠিক নাম এবং SID দেখে নিন।</div>\n\n        <p style=\"font-size: 0.9rem; margin-bottom: 4px;\"><b>ইউজার ফোল্ডারের নাম দেখতে:</b></p>\n        <div class=\"code-box\">\n            <code>dir C:\\Users</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n\n        <hr class=\"divider\">\n\n        <p style=\"font-size: 0.9rem; margin-bottom: 4px;\"><b>SID নম্বর দেখতে (সব Windows 11 ভার্সনে কাজ করবে):</b></p>\n        <div class=\"code-box\">\n            <code>powershell \"Get-LocalUser | Select-Object Name, SID\"</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n    </div>\n\n    <!-- STEP 4 -->\n    <div class=\"step-card\">\n        <div class=\"step-header\">\n            <span class=\"step-title\">৪. নির্দিষ্ট ইউজারকে শুধু ১টি অ্যাপের অ্যাক্সেস দেওয়া (Shell Lock)</span>\n            <span class=\"badge badge-cmd\">CMD (Run as Administrator)</span>\n        </div>\n        <div class=\"action-note\">নিচের ৩টি কমান্ড একে একে Admin CMD-তে রান করুন। (<span class=\"highlight\">Family</span> এবং অ্যাপের পাথ আপনার প্রয়োজনমতো পরিবর্তন করুন)</div>\n\n        <p style=\"font-size: 0.9rem; margin-bottom: 4px;\"><b>ধাপ ক — ইউজারের রেজিস্ট্রি লোড করুন:</b></p>\n        <div class=\"code-box\">\n            <code>reg load HKU\\FamilyShell \"C:\\Users\\Family\\NTUSER.DAT\"</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n\n        <p style=\"font-size: 0.9rem; margin: 12px 0 4px;\"><b>ধাপ খ — নির্দিষ্ট অ্যাপ সেট করুন (উদাহরণ: Google Chrome):</b></p>\n        <div class=\"code-box\">\n            <code>reg add \"HKU\\FamilyShell\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\" /v Shell /t REG_SZ /d \"\\\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\\\"\" /f</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n\n        <p style=\"font-size: 0.9rem; margin: 12px 0 4px;\"><b>ধাপ গ — রেজিস্ট্রি আনলোড করুন (অবশ্যই করতে হবে):</b></p>\n        <div class=\"code-box\">\n            <code>reg unload HKU\\FamilyShell</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n    </div>\n\n    <!-- STEP 5 -->\n    <div class=\"step-card\">\n        <div class=\"step-header\">\n            <span class=\"step-title\">৫. অ্যাক্সেস রিসেট / আগের মতো সাধারণ ডেস্কটপ ফিরিয়ে আনা</span>\n            <span class=\"badge badge-cmd\">CMD (Run as Administrator)</span>\n        </div>\n        <div class=\"action-note\">ভবিষ্যতে এই ইউজারকে আবার সাধারণ পিসি ব্যবহারের পারমিশন দিতে চাইলে নিচের ৩টি কমান্ড দিন:</div>\n\n        <div class=\"code-box\">\n            <code>reg load HKU\\FamilyShell \"C:\\Users\\Family\\NTUSER.DAT\"</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n        <div class=\"code-box\">\n            <code>reg delete \"HKU\\FamilyShell\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\" /v Shell /f</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n        <div class=\"code-box\">\n            <code>reg unload HKU\\FamilyShell</code>\n            <button class=\"copy-btn\" onclick=\"copyCode(this)\">Copy</button>\n        </div>\n    </div>\n\n    <!-- STEP 6 -->\n    <div class=\"step-card\">\n        <div class=\"step-header\">\n            <span class=\"step-title\">৬. জরুরি শর্টকাট (Restricted User-এ থাকা অবস্থায়)</span>\n            <span class=\"badge badge-ui\">Keyboard Shortcuts</span>\n        </div>\n        <ul class=\"sub-list\">\n            <li>• <b>Sign out / অ্যাকাউন্ট পরিবর্তন করতে:</b> <span class=\"highlight\">Ctrl + Alt + Del</span></li>\n            <li>• <b>Task Manager ওপেন করতে:</b> <span class=\"highlight\">Ctrl + Shift + Esc</span> (সেখান থেকে <i>File > Run new task > explorer.exe</i> দিলে সাময়িকভাবে ডেস্কটপ আসবে)</li>\n        </ul>\n    </div>\n</div>\n\n<script>\n    function copyCode(btn) {\n        const codeText = btn.previousElementSibling.innerText;\n        navigator.clipboard.writeText(codeText).then(() => {\n            const originalText = btn.innerText;\n            btn.innerText = 'Copied!';\n            btn.classList.add('copied');\n            setTimeout(() => {\n                btn.innerText = originalText;\n                btn.classList.remove('copied');\n            }, 1500);\n        });\n    }\n</script>\n\n</body>\n</html>\n"
}