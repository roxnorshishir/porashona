    "title": "২.১ অনুপাত ও সমানুপাতের ধারণা",
    "name": "২.১ অনুপাত ও সমানুপাতের ধারণা",
    "description": "",
    "summary": "<!DOCTYPE html>\n<html lang=\"bn\" class=\"h-full\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Hadar's Pronunciation Confidence Method & Guide</title>\n  \n  <!-- Tailwind CSS -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  \n  <!-- Google Fonts -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap\" rel=\"stylesheet\">\n  \n  <!-- Lucide Icons -->\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n\n  <script>\n    tailwind.config = {\n      darkMode: 'class',\n      theme: {\n        extend: {\n          fontFamily: {\n            siliguri: ['\"Hind Siliguri\"', 'sans-serif'],\n            mono: ['\"JetBrains Mono\"', 'monospace'],\n            sans: ['\"Plus Jakarta Sans\"', 'sans-serif']\n          },\n          colors: {\n            brand: {\n              400: '#22d3ee',\n              500: '#06b6d4',\n              600: '#0891b2',\n            }\n          }\n        }\n      }\n    }\n  </script>\n\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    body {\n      font-family: 'Hind Siliguri', sans-serif;\n    }\n\n    /* Custom Scrollbar for Light and Dark Modes */\n    .custom-scroll {\n      overflow-y: auto;\n      overflow-x: hidden;\n    }\n    .custom-scroll::-webkit-scrollbar {\n      width: 5px;\n      height: 5px;\n    }\n    .custom-scroll::-webkit-scrollbar-track {\n      background: transparent;\n    }\n    .custom-scroll::-webkit-scrollbar-thumb {\n      background: #cbd5e1;\n      border-radius: 9999px;\n    }\n    .dark .custom-scroll::-webkit-scrollbar-thumb {\n      background: #334155;\n    }\n    .custom-scroll::-webkit-scrollbar-thumb:hover {\n      background: #94a3b8;\n    }\n    .dark .custom-scroll::-webkit-scrollbar-thumb:hover {\n      background: #475569;\n    }\n\n    /* TOC Active State for Light & Dark */\n    .toc-item-link {\n      border-left: 3px solid transparent;\n      transition: all 0.15s ease-in-out;\n    }\n    .toc-item-link:hover {\n      background: rgba(224, 242, 254, 0.7);\n      color: #0284c7;\n      border-left-color: #0284c7;\n    }\n    .dark .toc-item-link:hover {\n      background: rgba(30, 41, 59, 0.7);\n      color: #38bdf8;\n      border-left-color: #38bdf8;\n    }\n    .toc-item-link.active {\n      background: rgba(6, 182, 212, 0.14) !important;\n      color: #0891b2 !important;\n      font-weight: 700;\n      border-left-color: #06b6d4 !important;\n    }\n    .dark .toc-item-link.active {\n      background: rgba(6, 182, 212, 0.12) !important;\n      color: #22d3ee !important;\n      border-left-color: #06b6d4 !important;\n    }\n\n    /* 16:9 Video docked frame */\n    .video-docked-box {\n      width: 100% !important;\n      aspect-ratio: 16 / 9;\n      height: auto !important;\n      position: relative;\n      flex-shrink: 0;\n      border-radius: 0.75rem;\n      overflow: hidden;\n      background: #000;\n    }\n\n    /* Floating Video Mode */\n    .video-floating-mode {\n      position: fixed !important;\n      z-index: 99999 !important;\n      width: 380px !important;\n      max-width: 90vw !important;\n      aspect-ratio: 16 / 9;\n      height: auto !important;\n      box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.45), 0 0 20px rgba(6, 182, 212, 0.35) !important;\n      border: 1px solid rgba(6, 182, 212, 0.7) !important;\n      border-radius: 0.875rem !important;\n      background: #000 !important;\n      overflow: hidden;\n    }\n\n    /* Resizer Divider between Sidebar and Viewport */\n    .resizer-divider {\n      width: 6px;\n      margin-left: -3px;\n      margin-right: -3px;\n      cursor: col-resize;\n      position: relative;\n      z-index: 45;\n      user-select: none;\n      transition: background-color 0.2s;\n    }\n    .resizer-divider:hover,\n    .resizer-divider.dragging {\n      background-color: #06b6d4 !important;\n    }\n    .resizer-divider::after {\n      content: '';\n      position: absolute;\n      top: 0;\n      bottom: 0;\n      left: -4px;\n      right: -4px;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen lg:h-full lg:overflow-hidden select-text antialiased transition-colors duration-200\">\n\n  <div class=\"w-full min-h-screen lg:h-full flex flex-col overflow-hidden\">\n\n<!-- হেডার টপবার -->\n<header class=\"h-14 bg-white/95 dark:bg-slate-900/90 border-b border-slate-200 dark:border-slate-800/80 px-4 sm:px-6 flex items-center justify-between shrink-0 z-40 backdrop-blur-md transition-colors duration-200\">\n  <div class=\"flex items-center gap-3\">\n    <div class=\"w-8 h-8 rounded-lg bg-cyan-500/15 dark:bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30 flex items-center justify-center font-mono font-bold text-xs\">\n      ENG\n    </div>\n    <div>\n      <h1 class=\"text-sm font-bold text-slate-900 dark:text-white font-sans tracking-tight\">Third Conditional Masterclass</h1>\n      <p class=\"text-[11px] text-slate-500 dark:text-slate-400 hidden sm:block\">Emma (mmmEnglish) - Complete Grammar Lesson</p>\n    </div>\n  </div>\n\n  <div class=\"flex items-center gap-2.5\">\n    <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-mono font-semibold bg-cyan-100 dark:bg-cyan-950/80 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800/50\">\n      <i data-lucide=\"youtube\" class=\"w-3.5 h-3.5\"></i> YOUTUBE SYNCED\n    </span>\n\n    <!-- Light / Dark Theme Toggle Button -->\n    <button id=\"theme-toggle-btn\" type=\"button\" onclick=\"toggleTheme()\" title=\"Switch Light/Dark Mode\"\n            class=\"w-8 h-8 rounded-lg flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-amber-400 border border-slate-200 dark:border-slate-700 transition-all duration-150 active:scale-95 cursor-pointer\">\n      <i id=\"theme-icon\" data-lucide=\"moon\" class=\"w-4 h-4\"></i>\n    </button>\n  </div>\n</header>\n\n<!-- মূল অ্যাপ্লিকেশন ওয়ার্কস্পেস -->\n<div id=\"app-workspace\" class=\"flex-1 flex flex-col lg:flex-row min-h-0 w-full overflow-hidden relative\">\n\n  <!-- সাইডবার: বাই ডিফল্ট ৩০% উইডথ -->\n  <aside id=\"toc-panel\" class=\"w-full lg:w-[30%] h-auto lg:h-full bg-white dark:bg-slate-950 flex flex-col p-3 shrink-0 z-30 custom-scroll border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-slate-800/80 transition-colors duration-200\" style=\"min-width: 260px; max-width: 55vw;\">\n    \n    <!-- ভিডিও স্লট -->\n    <div id=\"video-dock-anchor\" class=\"w-full shrink-0 flex flex-col items-center justify-center transition-all duration-300 mb-3\">\n      \n      <div id=\"master-video-card\" class=\"video-docked-box border border-slate-300 dark:border-slate-800 shadow-sm transition-all duration-200\">\n        \n        <div id=\"video-drag-handle-bar\" class=\"hidden absolute top-0 inset-x-0 h-7 z-40 bg-gradient-to-b from-slate-950/90 to-transparent flex items-center px-2 cursor-grab active:cursor-grabbing select-none\">\n          <span class=\"text-[10px] font-mono text-cyan-300 flex items-center gap-1 pointer-events-none drop-shadow\">\n            <i data-lucide=\"grip-horizontal\" class=\"w-3.5 h-3.5\"></i> মুভ করুন\n          </span>\n        </div>\n        <div id=\"drag-shield\" class=\"hidden absolute inset-0 z-35 bg-transparent\"></div>\n        <button id=\"pin-toggle-btn\" type=\"button\" onclick=\"togglePinVideo(event)\" title=\"পিন / আনপিন করুন\" \n                class=\"absolute top-1.5 right-1.5 z-50 w-6 h-6 rounded bg-slate-900/80 hover:bg-cyan-500 text-slate-200 hover:text-slate-950 border border-slate-600 hover:border-cyan-400 flex items-center justify-center shadow-md backdrop-blur-md transition-all active:scale-90 cursor-pointer\">\n          <i id=\"pin-icon\" data-lucide=\"pin\" class=\"w-3.5 h-3.5 fill-current\"></i>\n        </button>\n\n        <!-- ইউটিউব আইফ্রেম -->\n        <iframe \n          id=\"main-video-iframe\"\n          src=\"https://www.youtube.com/embed/xwOCqtaZDrk?enablejsapi=1\" \n          class=\"w-full h-full block relative z-10\" \n          style=\"border:none;\" \n          allowfullscreen=\"true\" \n          allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\">\n        </iframe>\n\n      </div>\n    </div>\n\n    <!-- সূচিপত্র (TOC) -->\n    <nav id=\"toc-nav-wrapper\" class=\"w-full text-xs space-y-3\">\n      <div class=\"flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800/80\">\n        <span class=\"text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-mono flex items-center gap-1.5\">\n          <i data-lucide=\"list-ordered\" class=\"w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400\"></i> কন্টেন্ট ও টাইমস্ট্যাম্প\n        </span>\n        <span class=\"text-[10px] font-mono text-cyan-700 dark:text-cyan-400 bg-cyan-100 dark:bg-cyan-950/60 px-2 py-0.5 rounded-full border border-cyan-200 dark:border-cyan-800/50\">সম্পূর্ণ লেসন</span>\n      </div>\n\n      <!-- গ্রুপ ১ -->\n      <div class=\"space-y-1\">\n        <div class=\"text-[10px] font-bold uppercase text-slate-400 dark:text-slate-500 font-mono tracking-wider px-2\">\n          ১. ভূমিকা ও কনসেপ্ট\n        </div>\n        <ul class=\"space-y-0.5\">\n          <li>\n            <a href=\"#intro\" data-target=\"intro\" class=\"toc-item-link flex flex-col px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300\">\n              <span class=\"text-[13px] font-semibold mb-1\">ভূমিকা ও অতীতের আক্ষেপ</span>\n              <div class=\"flex justify-between items-center w-full\">\n                <span class=\"text-[11px] text-slate-500\">Introduction to Regrets</span>\n                <span onclick=\"seekVideo(0, event)\" class=\"ts-badge\"><i data-lucide=\"play\" class=\"w-2.5 h-2.5\"></i> Play</span>\n              </div>\n            </a>\n          </li>\n          <li>\n            <a href=\"#examples-1\" data-target=\"examples-1\" class=\"toc-item-link flex flex-col px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300\">\n              <span class=\"text-[13px] font-semibold mb-1\">প্রাথমিক উদাহরণসমূহ</span>\n              <div class=\"flex justify-between items-center w-full\">\n                <span class=\"text-[11px] text-slate-500\">Missed flight & Rude behavior</span>\n                <span onclick=\"seekVideo(75, event)\" class=\"ts-badge\"><i data-lucide=\"play\" class=\"w-2.5 h-2.5\"></i> Play</span>\n              </div>\n            </a>\n          </li>\n        </ul>\n      </div>\n\n      <!-- গ্রুপ ২ -->\n      <div class=\"space-y-1\">\n        <div class=\"text-[10px] font-bold uppercase text-indigo-600 dark:text-indigo-400 font-mono tracking-wider px-2\">\n          ২. গ্রামার স্ট্রাকচার\n        </div>\n        <ul class=\"space-y-0.5\">\n          <li>\n            <a href=\"#structure\" data-target=\"structure\" class=\"toc-item-link flex flex-col px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300\">\n              <span class=\"text-[13px] font-semibold mb-1\">কীভাবে বাক্য গঠন করবেন?</span>\n              <div class=\"flex justify-between items-center w-full\">\n                <span class=\"text-[11px] text-slate-500\">Past Perfect + Conditional</span>\n                <span onclick=\"seekVideo(165, event)\" class=\"ts-badge\"><i data-lucide=\"play\" class=\"w-2.5 h-2.5\"></i> Play</span>\n              </div>\n            </a>\n          </li>\n          <li>\n            <a href=\"#more-examples\" data-target=\"more-examples\" class=\"toc-item-link flex flex-col px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300\">\n              <span class=\"text-[13px] font-semibold mb-1\">স্ট্রাকচার অনুযায়ী বিশ্লেষণ</span>\n              <div class=\"flex justify-between items-center w-full\">\n                <span class=\"text-[11px] text-slate-500\">Putting it all together</span>\n                <span onclick=\"seekVideo(220, event)\" class=\"ts-badge\"><i data-lucide=\"play\" class=\"w-2.5 h-2.5\"></i> Play</span>\n              </div>\n            </a>\n          </li>\n        </ul>\n      </div>\n\n      <!-- গ্রুপ ৩ -->\n      <div class=\"space-y-1\">\n        <div class=\"text-[10px] font-bold uppercase text-emerald-600 dark:text-emerald-400 font-mono tracking-wider px-2\">\n          ৩. মোডাল ভার্ব ও কুইজ\n        </div>\n        <ul class=\"space-y-0.5\">\n          <li>\n            <a href=\"#modals\" data-target=\"modals\" class=\"toc-item-link flex flex-col px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300\">\n              <span class=\"text-[13px] font-semibold mb-1\">Might vs Could এর ব্যবহার</span>\n              <div class=\"flex justify-between items-center w-full\">\n                <span class=\"text-[11px] text-slate-500\">Advanced usage</span>\n                <span onclick=\"seekVideo(320, event)\" class=\"ts-badge\"><i data-lucide=\"play\" class=\"w-2.5 h-2.5\"></i> Play</span>\n              </div>\n            </a>\n          </li>\n          <li>\n            <a href=\"#full-quiz\" data-target=\"full-quiz\" class=\"toc-item-link flex flex-col px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300\">\n              <span class=\"text-[13px] font-semibold mb-1\">সম্পূর্ণ মিনি কুইজ (৪টি পরিস্থিতি)</span>\n              <div class=\"flex justify-between items-center w-full\">\n                <span class=\"text-[11px] text-slate-500\">Test your knowledge</span>\n                <span onclick=\"seekVideo(420, event)\" class=\"ts-badge\"><i data-lucide=\"play\" class=\"w-2.5 h-2.5\"></i> Play</span>\n              </div>\n            </a>\n          </li>\n        </ul>\n      </div>\n    </nav>\n  </aside>\n\n  <!-- VS Code স্টাইল ড্র্যাগেবল স্প্লিটার ডিভাইডার -->\n  <div id=\"drag-resizer\" class=\"hidden lg:block resizer-divider bg-slate-300 dark:bg-slate-800 hover:bg-cyan-500\"></div>\n\n  <!-- মেইন ভিউপোর্ট -->\n  <main id=\"doc-viewport\" class=\"flex-1 h-full overflow-y-auto custom-scroll p-5 sm:p-8 lg:p-12 relative z-10 bg-slate-50 dark:bg-slate-950 transition-colors duration-200\">\n    <article class=\"w-full space-y-10 pb-28 max-w-4xl mx-auto\">\n\n      <!-- সেকশন ১: ভূমিকা -->\n      <section id=\"intro\" class=\"space-y-4 pt-1\">\n        <div class=\"flex flex-wrap items-center justify-between gap-2\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-100 dark:bg-cyan-950/70 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800/60 font-mono\">\n              <i data-lucide=\"book-open\" class=\"w-3 h-3\"></i> COMPLETE LESSON\n            </span>\n            <span class=\"text-xs font-mono text-slate-500 dark:text-slate-400\">Emma from mmmEnglish</span>\n          </div>\n          <button onclick=\"seekVideo(0, event)\" class=\"ts-badge text-sm px-3 py-1\">\n            <i data-lucide=\"play-circle\" class=\"w-4 h-4\"></i> ভিডিওর শুরু থেকে দেখুন\n          </button>\n        </div>\n\n        <h1 class=\"text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight font-sans\">\n          Third Conditional Sentences: <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-teal-500 dark:from-cyan-400 dark:to-teal-300\">অতীতের আক্ষেপ এবং কাল্পনিক ফলাফল</span>\n        </h1>\n\n        <p class=\"text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed\">\n          আপনি কি কখনো চেয়েছেন যে অতীতের কোনো ঘটনা যদি অন্যরকম হতো? হয়তো আপনি ভেবেছেন যে আপনার আচরণ ভিন্ন হওয়া উচিত ছিল, কিংবা এমন কোনো কাজে 'হ্যাঁ' বলা উচিত ছিল যা আপনি বলেননি। মানুষ হিসেবে আমরা সবাই এমনটা ফিল করি। এই লেসনে আমরা শিখব থার্ড কন্ডিশনাল (Third Conditional)—যা দিয়ে আমরা আমাদের হতাশা এবং আক্ষেপগুলো (regrets and disappointments) সুন্দরভাবে ইংরেজিতে প্রকাশ করতে পারি।\n        </p>\n        \n        <div class=\"p-4 rounded-xl bg-white dark:bg-slate-900/80 border-l-4 border-cyan-500 text-sm text-slate-700 dark:text-slate-200 leading-relaxed shadow-sm border border-slate-200/80 dark:border-slate-800\">\n          <span class=\"text-cyan-600 dark:text-cyan-400 font-bold\">Unreal Past:</span> জিরো, ফার্স্ট বা সেকেন্ড কন্ডিশনাল থেকে এটি ভিন্ন। থার্ড কন্ডিশনাল মূলত অতীত নিয়ে কথা বলে, তবে বাস্তব অতীত নয়—একটি <strong>কাল্পনিক অতীত (Unreal Past)</strong> এবং তার কাল্পনিক ফলাফল নিয়ে। যেহেতু আমরা অতীত পরিবর্তন করতে পারি না, তাই এটি দিয়ে মূলত আক্ষেপ বোঝানো হয়।\n        </div>\n      </section>\n\n      <!-- সেকশন ২: প্রথমিক উদাহরণ -->\n      <section id=\"examples-1\" class=\"space-y-6\">\n        <div class=\"flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3\">\n          <div class=\"flex items-center gap-2.5\">\n            <div class=\"p-2 rounded-lg bg-indigo-500/10 text-indigo-600 dark:text-indigo-400\">\n              <i data-lucide=\"message-square\" class=\"w-5 h-5\"></i>\n            </div>\n            <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans\">বাস্তব জীবনের উদাহরণসমূহ</h2>\n          </div>\n          <button onclick=\"seekVideo(75, event)\" class=\"ts-badge\">\n            <i data-lucide=\"play\" class=\"w-3.5 h-3.5\"></i> Examples\n          </button>\n        </div>\n\n        <div class=\"space-y-4\">\n          <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 shadow-sm\">\n            <h3 class=\"text-sm font-bold text-cyan-600 dark:text-cyan-400 mb-2\">১. ফ্লাইট মিস করা (Regret)</h3>\n            <p class=\"text-base font-mono text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-950 p-3 rounded-lg border border-slate-200 dark:border-slate-800\">\n              \"If I had left earlier, I wouldn't have missed my flight.\"\n            </p>\n            <p class=\"text-sm text-slate-600 dark:text-slate-400 mt-2\">\n              <strong>বিশ্লেষণ:</strong> আমি ফ্লাইট মিস করায় হতাশ। আমি চাই আমি যদি আরেকটু আগে বাড়ি থেকে বের হতাম এবং দেরি না করতাম। আমি চাইলেও এখন অতীতে গিয়ে প্লেনে উঠতে পারব না, কারণ ফ্লাইট চলে গেছে।\n            </p>\n          </div>\n\n          <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 shadow-sm\">\n            <h3 class=\"text-sm font-bold text-emerald-600 dark:text-emerald-400 mb-2\">২. খারাপ আচরণ এবং তিরস্কার (Scolding)</h3>\n            <p class=\"text-base font-mono text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-950 p-3 rounded-lg border border-slate-200 dark:border-slate-800\">\n              \"If you hadn't been so rude, they would have invited you back.\"\n            </p>\n            <p class=\"text-sm text-slate-600 dark:text-slate-400 mt-2\">\n              <strong>বিশ্লেষণ:</strong> তুমি রুক্ষ আচরণ করেছিলে, যার ফল ভালো হয়নি। তারা তোমাকে ভবিষ্যতে আর ডাকবে না। তুমি এখন চাইলেও অতীত পরিবর্তন করতে পারবে না। থার্ড কন্ডিশনাল দিয়ে এখানে কাউকে তার অতীত ভুলের জন্য বকা বা তিরস্কার করা হচ্ছে।\n            </p>\n          </div>\n\n          <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 shadow-sm\">\n            <h3 class=\"text-sm font-bold text-amber-600 dark:text-amber-400 mb-2\">৩. স্পিডিং জরিমানা (Frustration)</h3>\n            <p class=\"text-base font-mono text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-950 p-3 rounded-lg border border-slate-200 dark:border-slate-800\">\n              \"If I hadn't been going so fast, I wouldn't have been fined.\"\n            </p>\n            <p class=\"text-sm text-slate-600 dark:text-slate-400 mt-2\">\n              <strong>বিশ্লেষণ:</strong> আমি খুব দ্রুত গাড়ি চালিয়েছিলাম বলে জরিমানা পেয়েছি, যা খুবই বিরক্তিকর। কিন্তু এটি ঘটে গেছে এবং আমি পরিবর্তন করতে পারব না।\n            </p>\n          </div>\n        </div>\n      </section>\n\n      <!-- সেকশন ৩: স্ট্রাকচার -->\n      <section id=\"structure\" class=\"space-y-6\">\n        <div class=\"flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3\">\n          <div class=\"flex items-center gap-2.5\">\n            <div class=\"p-2 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400\">\n              <i data-lucide=\"cpu\" class=\"w-5 h-5\"></i>\n            </div>\n            <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans\">গঠনপ্রণালী (How to form it)</h2>\n          </div>\n          <button onclick=\"seekVideo(165, event)\" class=\"ts-badge\">\n            <i data-lucide=\"play\" class=\"w-3.5 h-3.5\"></i> Structure\n          </button>\n        </div>\n\n        <p class=\"text-slate-700 dark:text-slate-300\">থার্ড কন্ডিশনাল তৈরি করতে আমাদের কয়েকটি নির্দিষ্ট গ্রামার স্ট্রাকচার প্রয়োজন:</p>\n        \n        <div class=\"p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm space-y-5\">\n          <div class=\"text-center font-mono font-bold text-lg bg-cyan-50 dark:bg-cyan-950/40 p-4 rounded-xl border border-cyan-200 dark:border-cyan-800/60 text-slate-800 dark:text-slate-200\">\n            [If + Past Perfect] , [Perfect Conditional]\n          </div>\n          \n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <div>\n              <h4 class=\"font-bold text-cyan-600 dark:text-cyan-400 border-b border-slate-200 dark:border-slate-800 pb-2 mb-3\">১. The 'If' Clause (Past Perfect)</h4>\n              <ul class=\"space-y-2 text-sm text-slate-600 dark:text-slate-300\">\n                <li>গঠন: <strong>Subject + had + past participle verb (V3)</strong></li>\n                <li class=\"italic border-l-2 border-cyan-400 pl-2\">If I had left earlier...</li>\n                <li class=\"italic border-l-2 border-cyan-400 pl-2\">If you hadn't been so rude...</li>\n                <li class=\"italic border-l-2 border-cyan-400 pl-2\">If I hadn't been going so fast...</li>\n              </ul>\n            </div>\n            \n            <div>\n              <h4 class=\"font-bold text-emerald-600 dark:text-emerald-400 border-b border-slate-200 dark:border-slate-800 pb-2 mb-3\">২. The Main Clause (Perfect Conditional)</h4>\n              <ul class=\"space-y-2 text-sm text-slate-600 dark:text-slate-300\">\n                <li>গঠন: <strong>Subject + would have + past participle verb (V3)</strong></li>\n                <li class=\"italic border-l-2 border-emerald-400 pl-2\">...I wouldn't have missed my flight.</li>\n                <li class=\"italic border-l-2 border-emerald-400 pl-2\">...they would have invited you back.</li>\n                <li class=\"italic border-l-2 border-emerald-400 pl-2\">...I wouldn't have got that ticket.</li>\n              </ul>\n            </div>\n          </div>\n          <div class=\"text-xs text-rose-500 dark:text-rose-400 font-bold text-center mt-2\">\n            * মনে রাখবেন: দুটি ক্লজের মাঝখানে অবশ্যই একটি কমা (,) বসাতে হবে।\n          </div>\n        </div>\n      </section>\n\n      <!-- সেকশন ৪: আরও বিশ্লেষণ -->\n      <section id=\"more-examples\" class=\"space-y-6\">\n        <div class=\"flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3\">\n          <div class=\"flex items-center gap-2.5\">\n            <div class=\"p-2 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400\">\n              <i data-lucide=\"check-circle\" class=\"w-5 h-5\"></i>\n            </div>\n            <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans\">বাক্য বিশ্লেষণ ও অর্থ যাচাই</h2>\n          </div>\n          <button onclick=\"seekVideo(220, event)\" class=\"ts-badge\">\n            <i data-lucide=\"play\" class=\"w-3.5 h-3.5\"></i> Practice\n          </button>\n        </div>\n\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n          <div class=\"p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800\">\n            <p class=\"font-mono text-sm text-slate-900 dark:text-white mb-2 font-semibold\">\n              \"If she had replied to my message, I wouldn't have been so worried.\"\n            </p>\n            <p class=\"text-xs text-slate-600 dark:text-slate-400\">\n              <strong>বাস্তবতা:</strong> সে আমার মেসেজের রিপ্লাই দেয়নি, তাই আমি চিন্তিত ছিলাম। এখানে আমি হতাশা প্রকাশ করছি যে, সে রিপ্লাই দিলে আমাকে চিন্তা করতে হতো না।\n            </p>\n          </div>\n\n          <div class=\"p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800\">\n            <p class=\"font-mono text-sm text-slate-900 dark:text-white mb-2 font-semibold\">\n              \"If I had taken better care of myself, I wouldn't have got sick.\"\n            </p>\n            <p class=\"text-xs text-slate-600 dark:text-slate-400\">\n              <strong>বাস্তবতা:</strong> আমি নিজের যত্ন নিইনি, তাই অসুস্থ হয়েছি। এখানে নিজের অতীতের কাজের প্রতি রিগ্রেট বা আক্ষেপ প্রকাশ পাচ্ছে।\n            </p>\n          </div>\n        </div>\n      </section>\n\n      <!-- সেকশন ৫: Modals -->\n      <section id=\"modals\" class=\"space-y-6\">\n        <div class=\"flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3\">\n          <div class=\"flex items-center gap-2.5\">\n            <div class=\"p-2 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400\">\n              <i data-lucide=\"sliders\" class=\"w-5 h-5\"></i>\n            </div>\n            <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans\">Might ও Could এর ব্যবহার (Modals)</h2>\n          </div>\n          <button onclick=\"seekVideo(320, event)\" class=\"ts-badge\">\n            <i data-lucide=\"play\" class=\"w-3.5 h-3.5\"></i> Modals\n          </button>\n        </div>\n\n        <p class=\"text-slate-700 dark:text-slate-300\">মেইন ক্লজে সবসময় 'would have' ব্যবহার করতে হবে এমন নয়, আমরা চাইলে সম্ভাবনা বা সামর্থ্য বোঝাতে 'might have' এবং 'could have' ব্যবহার করতে পারি।</p>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n          <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm border-l-4 border-l-amber-500\">\n            <h4 class=\"text-base font-bold text-amber-600 dark:text-amber-400 mb-2\">Might Have (সম্ভাবনা)</h4>\n            <p class=\"text-sm font-mono bg-slate-100 dark:bg-slate-950 p-2 rounded text-slate-800 dark:text-slate-200 mb-3\">\"If she'd studied more, she might have passed.\"</p>\n            <p class=\"text-sm text-slate-600 dark:text-slate-300\">\n              যখন আমরা কাল্পনিক ফলাফলটি নিয়ে ১০০% নিশ্চিত নই (হয়তো সে পাস করত, হয়তো আবার ফেল করত), তখন 'would have' এর পরিবর্তে 'might have' ব্যবহার করা ভালো।\n            </p>\n          </div>\n\n          <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm border-l-4 border-l-purple-500\">\n            <h4 class=\"text-base font-bold text-purple-600 dark:text-purple-400 mb-2\">Could Have (সামর্থ্য বা এবিলিটি)</h4>\n            <p class=\"text-sm font-mono bg-slate-100 dark:bg-slate-950 p-2 rounded text-slate-800 dark:text-slate-200 mb-3\">\"If you had lent me your car, I could have got there faster.\"</p>\n            <p class=\"text-sm text-slate-600 dark:text-slate-300\">\n              আমি নিশ্চিতভাবে বলছি না যে আমি দ্রুত পৌঁছাতামই, বরং আমি বলছি যে গাড়ি থাকলে আমার দ্রুত পৌঁছানোর <strong>সামর্থ্য (ability)</strong> বা সুযোগ থাকতো।\n            </p>\n          </div>\n        </div>\n      </section>\n\n      <!-- সেকশন ৬: সম্পূর্ণ কুইজ -->\n      <section id=\"full-quiz\" class=\"space-y-6\">\n        <div class=\"flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3\">\n          <div class=\"flex items-center gap-2.5\">\n            <div class=\"p-2 rounded-lg bg-rose-500/10 text-rose-600 dark:text-rose-400\">\n              <i data-lucide=\"edit-3\" class=\"w-5 h-5\"></i>\n            </div>\n            <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans\">মিনি কুইজ: আপনার পালা! (Your Turn)</h2>\n          </div>\n          <button onclick=\"seekVideo(420, event)\" class=\"ts-badge\">\n            <i data-lucide=\"play\" class=\"w-3.5 h-3.5\"></i> Mini Quiz\n          </button>\n        </div>\n\n        <p class=\"text-slate-700 dark:text-slate-300\">নিচে ৪টি অতীতের পরিস্থিতি (Situation) দেওয়া হলো। তথ্যগুলো ব্যবহার করে থার্ড কন্ডিশনাল বাক্য তৈরি করুন। সঠিক স্ট্রাকচার এবং মোডাল ভার্ব (would/might/could) নির্বাচনের দিকে খেয়াল রাখবেন।</p>\n\n        <div class=\"space-y-4\">\n          <!-- Situation 1 -->\n          <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm relative overflow-hidden\">\n            <div class=\"absolute top-0 left-0 w-1 h-full bg-cyan-500\"></div>\n            <h3 class=\"text-sm font-bold text-slate-900 dark:text-white mb-2 uppercase font-mono tracking-wider\">Situation 1</h3>\n            <p class=\"text-sm text-slate-700 dark:text-slate-300 mb-3\">\n              Your friend was in trouble, they needed help. You had the ability to help but he never told you that he was in trouble.\n            </p>\n            <div class=\"bg-slate-100 dark:bg-slate-900 p-3 rounded border border-dashed border-slate-300 dark:border-slate-700\">\n              <p class=\"text-xs text-slate-500 dark:text-slate-400 font-mono italic\">আপনার উত্তর লিখুন: If he had...</p>\n            </div>\n          </div>\n\n          <!-- Situation 2 -->\n          <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm relative overflow-hidden\">\n            <div class=\"absolute top-0 left-0 w-1 h-full bg-emerald-500\"></div>\n            <h3 class=\"text-sm font-bold text-slate-900 dark:text-white mb-2 uppercase font-mono tracking-wider\">Situation 2</h3>\n            <p class=\"text-sm text-slate-700 dark:text-slate-300 mb-3\">\n              You showed up at a dinner party empty-handed. Everyone else had bought a dish to the party. You wish that you had brought something but you didn't know that you're supposed to.\n            </p>\n            <div class=\"bg-slate-100 dark:bg-slate-900 p-3 rounded border border-dashed border-slate-300 dark:border-slate-700\">\n              <p class=\"text-xs text-slate-500 dark:text-slate-400 font-mono italic\">আপনার উত্তর লিখুন: If I had known...</p>\n            </div>\n          </div>\n\n          <!-- Situation 3 -->\n          <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm relative overflow-hidden\">\n            <div class=\"absolute top-0 left-0 w-1 h-full bg-amber-500\"></div>\n            <h3 class=\"text-sm font-bold text-slate-900 dark:text-white mb-2 uppercase font-mono tracking-wider\">Situation 3</h3>\n            <p class=\"text-sm text-slate-700 dark:text-slate-300 mb-3\">\n              He was talking on the phone while driving. He got pulled over by the police. He got a huge fine. Now he regrets using his phone in the car.\n            </p>\n            <div class=\"bg-slate-100 dark:bg-slate-900 p-3 rounded border border-dashed border-slate-300 dark:border-slate-700\">\n              <p class=\"text-xs text-slate-500 dark:text-slate-400 font-mono italic\">আপনার উত্তর লিখুন: If he hadn't been...</p>\n            </div>\n          </div>\n\n          <!-- Situation 4 -->\n          <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm relative overflow-hidden\">\n            <div class=\"absolute top-0 left-0 w-1 h-full bg-purple-500\"></div>\n            <h3 class=\"text-sm font-bold text-slate-900 dark:text-white mb-2 uppercase font-mono tracking-wider\">Situation 4</h3>\n            <p class=\"text-sm text-slate-700 dark:text-slate-300 mb-3\">\n              Sarah went on a hike. She didn't bring a rain jacket. It started raining. And now Sarah's upset because she got really wet.\n            </p>\n            <div class=\"bg-slate-100 dark:bg-slate-900 p-3 rounded border border-dashed border-slate-300 dark:border-slate-700\">\n              <p class=\"text-xs text-slate-500 dark:text-slate-400 font-mono italic\">আপনার উত্তর লিখুন: If Sarah had...</p>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"mt-6 p-4 bg-cyan-50 dark:bg-cyan-900/20 border border-cyan-200 dark:border-cyan-800 rounded-xl text-sm text-cyan-800 dark:text-cyan-300 text-center font-medium\">\n          আপনার উত্তরগুলো ভিডিওর কমেন্ট বক্সে লিখে ফেলুন, এমা নিজে সেগুলো চেক করবেন!\n        </div>\n      </section>\n\n    </article>\n  </main>\n\n</div>\n\n  </div>\n\n  <!-- জাভাস্ক্রিপ্ট কন্ট্রোলার -->\n  <script>\n    // ==========================================\n    // থিম কন্ট্রোলার (Light/Dark Switch with LocalStorage)\n    // ==========================================\n    function applyTheme(isDark) {\n      const htmlEl = document.documentElement;\n      const themeIcon = document.getElementById('theme-icon');\n      \n      if (isDark) {\n        htmlEl.classList.add('dark');\n        if (themeIcon) themeIcon.setAttribute('data-lucide', 'sun');\n      } else {\n        htmlEl.classList.remove('dark');\n        if (themeIcon) themeIcon.setAttribute('data-lucide', 'moon');\n      }\n      lucide.createIcons();\n    }\n\n    function toggleTheme() {\n      const isDark = document.documentElement.classList.contains('dark');\n      const nextThemeIsDark = !isDark;\n      localStorage.setItem('theme_preference', nextThemeIsDark ? 'dark' : 'light');\n      applyTheme(nextThemeIsDark);\n    }\n\n    // ডিফল্ট লাইট মোড ইনিশিয়ালাইজেশন\n    (function initTheme() {\n      const saved = localStorage.getItem('theme_preference');\n      // ডিফল্ট লাইট মোড সক্রিয় (যদি 'dark' সংরক্ষণ করা থাকে তবেই ডার্ক মোড অন হবে)\n      const isDark = saved === 'dark';\n      applyTheme(isDark);\n    })();\n\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      lucide.createIcons();\n\n      // ==========================================\n      // ১. স্মুথ স্ক্রলিং ও TOC নেভিগেশন\n      // ==========================================\n      const navLinks = document.querySelectorAll(\"#toc-nav-wrapper a.toc-item-link\");\n      const docViewport = document.getElementById(\"doc-viewport\");\n      const appWorkspace = document.getElementById(\"app-workspace\");\n\n      const isDesktop = () => window.innerWidth >= 1024;\n\n      navLinks.forEach(link => {\n        link.addEventListener(\"click\", function(e) {\n          e.preventDefault();\n          const targetId = this.getAttribute(\"data-target\");\n          const targetEl = document.getElementById(targetId);\n          if (!targetEl) return;\n\n          if (isDesktop()) {\n            const containerRect = docViewport.getBoundingClientRect();\n            const targetRect = targetEl.getBoundingClientRect();\n            const offsetTop = targetRect.top - containerRect.top + docViewport.scrollTop - 20;\n\n            docViewport.scrollTo({\n              top: offsetTop,\n              behavior: \"smooth\"\n            });\n          } else {\n            const containerRect = appWorkspace.getBoundingClientRect();\n            const targetRect = targetEl.getBoundingClientRect();\n            const offsetTop = targetRect.top - containerRect.top + appWorkspace.scrollTop - 20;\n\n            appWorkspace.scrollTo({\n              top: offsetTop,\n              behavior: \"smooth\"\n            });\n          }\n\n          navLinks.forEach(l => l.classList.remove(\"active\"));\n          this.classList.add(\"active\");\n        });\n      });\n\n      // স্ক্রল স্পাই\n      const trackedSections = document.querySelectorAll(\"#doc-viewport section[id]\");\n      function initScrollSpy() {\n        const container = isDesktop() ? docViewport : appWorkspace;\n        const observer = new IntersectionObserver((entries) => {\n          entries.forEach(entry => {\n            if (entry.isIntersecting) {\n              const id = entry.target.getAttribute(\"id\");\n              navLinks.forEach(link => {\n                if (link.getAttribute(\"data-target\") === id) {\n                  link.classList.add(\"active\");\n                } else {\n                  link.classList.remove(\"active\");\n                }\n              });\n            }\n          });\n        }, {\n          root: container,\n          rootMargin: \"-10% 0px -70% 0px\",\n          threshold: 0\n        });\n\n        trackedSections.forEach(sec => observer.observe(sec));\n      }\n      initScrollSpy();\n      window.addEventListener(\"resize\", initScrollSpy);\n\n      // ==========================================\n      // ২. VS Code স্টাইল সাইডবার রিসাইজ (Resizer)\n      // ==========================================\n      const resizer = document.getElementById('drag-resizer');\n      const sidebar = document.getElementById('toc-panel');\n      let isResizing = false;\n\n      const resizerOverlay = document.createElement('div');\n      resizerOverlay.style.position = 'fixed';\n      resizerOverlay.style.inset = '0';\n      resizerOverlay.style.zIndex = '9999';\n      resizerOverlay.style.cursor = 'col-resize';\n      resizerOverlay.style.display = 'none';\n      document.body.appendChild(resizerOverlay);\n\n      resizer.addEventListener('mousedown', (e) => {\n        isResizing = true;\n        resizer.classList.add('dragging');\n        resizerOverlay.style.display = 'block';\n        document.body.style.userSelect = 'none';\n        e.preventDefault();\n      });\n\n      window.addEventListener('mousemove', (e) => {\n        if (!isResizing) return;\n        const workspaceRect = appWorkspace.getBoundingClientRect();\n        let newWidth = e.clientX - workspaceRect.left;\n\n        const minWidth = 220;\n        const maxWidth = workspaceRect.width * 0.55;\n\n        if (newWidth < minWidth) newWidth = minWidth;\n        if (newWidth > maxWidth) newWidth = maxWidth;\n\n        sidebar.style.width = `${newWidth}px`;\n      });\n\n      window.addEventListener('mouseup', () => {\n        if (isResizing) {\n          isResizing = false;\n          resizer.classList.remove('dragging');\n          resizerOverlay.style.display = 'none';\n          document.body.style.userSelect = '';\n        }\n      });\n\n      // ==========================================\n      // ৩. পিন / আনপিন এবং ফ্লোটিং মোড লজিক\n      // ==========================================\n      let isPinned = true;\n      const masterCard = document.getElementById('master-video-card');\n      const dockAnchor = document.getElementById('video-dock-anchor');\n      const pinBtn = document.getElementById('pin-toggle-btn');\n      const dragHandleBar = document.getElementById('video-drag-handle-bar');\n      const dragShield = document.getElementById('drag-shield');\n\n      window.togglePinVideo = function(e) {\n        if (e) {\n          e.stopPropagation();\n          e.preventDefault();\n        }\n        isPinned = !isPinned;\n\n        if (isPinned) {\n          // পিনড মোড\n          masterCard.classList.remove('video-floating-mode');\n          masterCard.classList.add('video-docked-box');\n          masterCard.style.top = '';\n          masterCard.style.left = '';\n          masterCard.style.right = '';\n          masterCard.style.bottom = '';\n\n          dockAnchor.appendChild(masterCard);\n          dragHandleBar.classList.add('hidden');\n          pinBtn.classList.remove('bg-amber-500', 'text-slate-950', 'border-amber-400');\n          pinBtn.classList.add('bg-slate-900/80', 'text-slate-200', 'border-slate-600');\n          pinBtn.innerHTML = `<i data-lucide=\"pin\" class=\"w-3.5 h-3.5 fill-current\"></i>`;\n        } else {\n          // ফ্লোটিং মোড\n          document.body.appendChild(masterCard);\n          masterCard.classList.remove('video-docked-box');\n          masterCard.classList.add('video-floating-mode');\n\n          masterCard.style.right = '24px';\n          masterCard.style.bottom = '24px';\n          masterCard.style.top = 'auto';\n          masterCard.style.left = 'auto';\n\n          dragHandleBar.classList.remove('hidden');\n          pinBtn.classList.remove('bg-slate-900/80', 'text-slate-200', 'border-slate-600');\n          pinBtn.classList.add('bg-amber-500', 'text-slate-950', 'border-amber-400');\n          pinBtn.innerHTML = `<i data-lucide=\"pin-off\" class=\"w-3.5 h-3.5\"></i>`;\n        }\n\n        lucide.createIcons();\n      };\n\n      // ==========================================\n      // ৪. ফ্লোটিং ভিডিও ড্র্যাগ লজিক\n      // ==========================================\n      let isDraggingVideo = false;\n      let startX, startY, initLeft, initTop;\n\n      function onDragStart(e) {\n        if (isPinned) return;\n        if (e.target.closest('#pin-toggle-btn')) return;\n\n        isDraggingVideo = true;\n        dragShield.classList.remove('hidden');\n\n        const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;\n        const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;\n\n        startX = clientX;\n        startY = clientY;\n\n        const rect = masterCard.getBoundingClientRect();\n        initLeft = rect.left;\n        initTop = rect.top;\n\n        masterCard.style.right = 'auto';\n        masterCard.style.bottom = 'auto';\n        masterCard.style.left = `${initLeft}px`;\n        masterCard.style.top = `${initTop}px`;\n\n        if (e.cancelable) e.preventDefault();\n      }\n\n      function onDragMove(e) {\n        if (!isDraggingVideo || isPinned) return;\n\n        const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;\n        const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;\n\n        const deltaX = clientX - startX;\n        const deltaY = clientY - startY;\n\n        let newX = initLeft + deltaX;\n        let newY = initTop + deltaY;\n\n        const cardW = masterCard.offsetWidth;\n        const cardH = masterCard.offsetHeight;\n        newX = Math.max(8, Math.min(newX, window.innerWidth - cardW - 8));\n        newY = Math.max(8, Math.min(newY, window.innerHeight - cardH - 8));\n\n        masterCard.style.left = `${newX}px`;\n        masterCard.style.top = `${newY}px`;\n      }\n\n      function onDragEnd() {\n        if (isDraggingVideo) {\n          isDraggingVideo = false;\n          dragShield.classList.add('hidden');\n        }\n      }\n\n      dragHandleBar.addEventListener('mousedown', onDragStart);\n      window.addEventListener('mousemove', onDragMove);\n      window.addEventListener('mouseup', onDragEnd);\n\n      dragHandleBar.addEventListener('touchstart', onDragStart, { passive: false });\n      window.addEventListener('touchmove', onDragMove, { passive: false });\n      window.addEventListener('touchend', onDragEnd);\n    });\n  </script>\n</body>\n</html>",
