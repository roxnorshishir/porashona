    "answer": "<!DOCTYPE html>\n<html lang=\"en\" class=\"scroll-smooth\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Shajedul Kabir Rafi — Odyssey & Timeline</title>\n  \n  <!-- Tailwind CSS -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  \n  <!-- Google Fonts: Bebas Neue, Cormorant Garamond, Inter -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@1,400;1,600;1,700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n  \n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          colors: {\n            noir: {\n              950: '#070204',\n              900: '#0e0407',\n              850: '#14060b',\n              800: '#1c0910',\n              750: '#240c15',\n              700: '#2e0f1b',\n              accent: '#bd334c',\n              glow: '#f43f5e',\n              roseBorder: 'rgba(244, 63, 94, 0.22)',\n              sand: '#ede0d4',\n              muted: '#a3928e',\n            }\n          },\n          fontFamily: {\n            display: ['\"Bebas Neue\"', 'sans-serif'],\n            serif: ['\"Cormorant Garamond\"', 'serif'],\n            sans: ['\"Inter\"', 'sans-serif'],\n            mono: ['\"JetBrains Mono\"', 'monospace'],\n          }\n        }\n      }\n    }\n  </script>\n\n  <style>\n    /* Custom Scrollbar */\n    ::-webkit-scrollbar {\n      width: 7px;\n    }\n    ::-webkit-scrollbar-track {\n      background: #090204;\n    }\n    ::-webkit-scrollbar-thumb {\n      background: #2b0f19;\n      border-radius: 4px;\n    }\n    ::-webkit-scrollbar-thumb:hover {\n      background: #bd334c;\n    }\n\n    /* Ambient radial glow */\n    .hero-glow {\n      background: radial-gradient(circle at 80% 20%, rgba(189, 51, 76, 0.22) 0%, rgba(18, 5, 10, 0.6) 45%, transparent 70%),\n                  radial-gradient(circle at 15% 85%, rgba(140, 29, 51, 0.16) 0%, transparent 60%);\n    }\n\n    .ambient-glow-center {\n      background: radial-gradient(circle at 50% 50%, rgba(189, 51, 76, 0.08) 0%, transparent 70%);\n    }\n\n    /* Dot grain texture */\n    .grain-overlay {\n      background-image: radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 0);\n      background-size: 24px 24px;\n    }\n\n    /* Active Glowing Spine Node */\n    .node-pulse-active {\n      box-shadow: 0 0 22px 6px rgba(244, 63, 94, 0.65);\n      border-color: #f43f5e !important;\n    }\n\n    /* Slide-in Animations for Left and Right alternating cards */\n    .timeline-card-left {\n      opacity: 0;\n      transform: translateX(-40px);\n      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n    .timeline-card-right {\n      opacity: 0;\n      transform: translateX(40px);\n      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n    .timeline-card-visible {\n      opacity: 1 !important;\n      transform: translateX(0) !important;\n    }\n\n    /* Card subtle gradient hover */\n    .card-glass {\n      background: linear-gradient(145deg, rgba(28, 9, 16, 0.75) 0%, rgba(14, 4, 7, 0.85) 100%);\n      backdrop-filter: blur(14px);\n      -webkit-backdrop-filter: blur(14px);\n    }\n    .card-glass:hover {\n      background: linear-gradient(145deg, rgba(38, 12, 22, 0.9) 0%, rgba(19, 5, 10, 0.95) 100%);\n    }\n  </style>\n</head>\n<body class=\"bg-noir-950 text-noir-sand font-sans selection:bg-noir-accent selection:text-white antialiased overflow-x-hidden\">\n\n  <!-- ================= TOP NAV BAR ================= -->\n  <header class=\"fixed top-0 left-0 right-0 z-50 backdrop-blur-xl bg-noir-950/85 border-b border-noir-roseBorder/30 px-5 sm:px-10 py-3.5 flex items-center justify-between transition-all duration-300\">\n    <div class=\"flex items-center gap-3\">\n      <div class=\"relative flex h-3 w-3\">\n        <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-noir-accent opacity-75\"></span>\n        <span class=\"relative inline-flex rounded-full h-3 w-3 bg-noir-accent\"></span>\n      </div>\n      <a href=\"#hero\" class=\"font-display tracking-widest text-lg md:text-xl text-noir-sand font-bold\">\n        RAFI<span class=\"text-noir-accent\">.DEV</span>\n      </a>\n    </div>\n    \n    <nav class=\"hidden md:flex items-center space-x-7 text-xs uppercase tracking-widest text-noir-muted\">\n      <a href=\"#hero\" class=\"hover:text-noir-sand transition-colors\">00 // Intro</a>\n      <a href=\"#path-section\" class=\"text-rose-300 font-semibold transition-colors flex items-center gap-1.5\">\n        <span class=\"w-1.5 h-1.5 rounded-full bg-noir-accent\"></span> 01 // The Path\n      </a>\n      <a href=\"#projects\" class=\"hover:text-noir-sand transition-colors\">02 // Creations</a>\n      <a href=\"#contact\" class=\"hover:text-noir-sand transition-colors\">03 // Connect</a>\n    </nav>\n\n    <div class=\"flex items-center gap-3\">\n      <button onclick=\"copyMail()\" id=\"navCopyBtn\" class=\"text-xs uppercase tracking-wider px-3.5 py-1.5 border border-noir-roseBorder/60 hover:border-noir-accent rounded-full text-noir-sand hover:text-white transition-all bg-noir-850/70 hover:bg-noir-accent/20 flex items-center gap-1.5\">\n        <span id=\"navCopyLabel\">Copy Email</span>\n      </button>\n    </div>\n  </header>\n\n  <!-- ================= HERO PREVIEW ================= -->\n  <section id=\"hero\" class=\"min-h-[85vh] relative flex items-center justify-center hero-glow grain-overlay pt-24 px-6 border-b border-noir-roseBorder/20\">\n    <div class=\"max-w-4xl mx-auto text-center space-y-6\">\n      \n      <div class=\"inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-noir-roseBorder bg-noir-900/80 text-[11px] font-mono tracking-widest text-rose-300 uppercase\">\n        <span class=\"w-2 h-2 rounded-full bg-noir-accent animate-pulse\"></span>\n        Portfolio & Chronological Timeline\n      </div>\n      \n      <h1 class=\"text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-display uppercase tracking-tight text-[#f5eae2] leading-[0.9]\">\n        ENGINEERING <br>\n        <span class=\"font-serif italic font-normal text-noir-accent lowercase tracking-normal text-4xl sm:text-6xl md:text-7xl lg:text-8xl\">with</span>\n        PRECISION.\n      </h1>\n      \n      <p class=\"max-w-xl mx-auto text-noir-muted text-sm sm:text-base leading-relaxed font-light\">\n        A dual-axis responsive timeline featuring alternating milestones, pinned profile context, dynamic filtering, and viewport fitting.\n      </p>\n\n      <div class=\"pt-6 flex flex-wrap items-center justify-center gap-4\">\n        <a href=\"#path-section\" class=\"px-7 py-3 rounded-full bg-gradient-to-r from-noir-accent to-[#942035] hover:opacity-95 text-white font-medium text-xs tracking-widest uppercase transition-all shadow-[0_0_25px_rgba(189,51,76,0.4)]\">\n          Explore The Path &darr;\n        </a>\n        <a href=\"#projects\" class=\"px-7 py-3 rounded-full border border-noir-roseBorder/60 hover:border-noir-accent text-zinc-300 hover:text-white font-medium text-xs tracking-widest uppercase transition-all bg-noir-900/40\">\n          Featured Works\n        </a>\n      </div>\n\n      <div class=\"pt-10 text-[11px] font-mono uppercase tracking-[0.25em] text-zinc-500 flex items-center justify-center gap-2\">\n        <svg class=\"w-4 h-4 animate-bounce text-noir-accent\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 14l-7 7m0 0l-7-7m7 7V3\"></path></svg>\n        <span>Scroll down to enter the timeline</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- ========================================================================= -->\n  <!-- MAIN TIMELINE SECTION WITH SPLIT SCREEN (STICKY RIGHT + ALTERNATING LEFT)  -->\n  <!-- ========================================================================= -->\n  <section id=\"path-section\" class=\"relative bg-noir-900 border-b border-noir-roseBorder/30 grain-overlay\">\n    \n    <!-- Ambient glow backdrop accents -->\n    <div class=\"absolute inset-0 pointer-events-none overflow-hidden\">\n      <div class=\"absolute top-1/4 right-1/4 w-[500px] h-[500px] bg-noir-accent/10 rounded-full blur-[140px]\"></div>\n      <div class=\"absolute bottom-1/3 left-10 w-[450px] h-[450px] bg-red-950/20 rounded-full blur-[160px]\"></div>\n    </div>\n\n    <div class=\"max-w-[1580px] mx-auto px-4 sm:px-6 lg:px-12 relative\">\n      \n      <!-- Responsive Grid: \n           Left col: Alternating Timeline cards (7 cols on lg, 8 cols on xl)\n           Right col: Perfectly scaled pinned profile (5 cols on lg, 4 cols on xl)\n      -->\n      <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12\">\n        \n        <!-- ================= LEFT AREA: ALTERNATING TIMELINE ================= -->\n        <div class=\"lg:col-span-7 xl:col-span-8 pt-12 md:pt-20 pb-28 order-2 lg:order-1\">\n          \n          <!-- Timeline Header -->\n          <div class=\"mb-10 sm:mb-14\">\n            <div class=\"flex items-center justify-between text-xs tracking-widest uppercase text-rose-300/70 pb-3 border-b border-noir-roseBorder/30\">\n              <span class=\"flex items-center gap-2 font-mono text-[11px] text-noir-accent\">\n                01 <span class=\"text-zinc-600\">&mdash;</span> A CHRONOLOGY\n              </span>\n              <span class=\"font-mono text-[11px] text-zinc-400 tracking-wider\">05 / MILESTONES</span>\n            </div>\n\n            <div class=\"mt-4 flex flex-wrap items-baseline gap-3\">\n              <h2 class=\"text-5xl sm:text-6xl md:text-7xl font-display tracking-tight text-[#f5eae2] uppercase leading-none\">\n                THE PATH\n              </h2>\n              <span class=\"font-serif italic text-3xl sm:text-4xl md:text-5xl text-rose-200/90 font-normal\">\n                so far.\n              </span>\n            </div>\n            \n            <p class=\"text-xs sm:text-sm text-zinc-400 mt-2 font-light max-w-lg\">\n              Milestones span across software engineering, academic excellence, leadership roles, and full-stack cloud systems.\n            </p>\n\n            <!-- Filter Controls for Timeline -->\n            <div class=\"mt-6 flex flex-wrap items-center gap-2 pt-2\" id=\"filterContainer\">\n              <button onclick=\"filterTimeline('all')\" data-filter=\"all\" class=\"timeline-filter active-filter px-3.5 py-1.5 rounded-full text-[11px] font-mono uppercase tracking-wider transition-all bg-noir-accent text-white border border-noir-accent shadow-[0_0_15px_rgba(189,51,76,0.3)]\">\n                All (5)\n              </button>\n              <button onclick=\"filterTimeline('experience')\" data-filter=\"experience\" class=\"timeline-filter px-3.5 py-1.5 rounded-full text-[11px] font-mono uppercase tracking-wider transition-all bg-noir-800/80 text-zinc-400 hover:text-white border border-noir-roseBorder/40\">\n                Experience (2)\n              </button>\n              <button onclick=\"filterTimeline('education')\" data-filter=\"education\" class=\"timeline-filter px-3.5 py-1.5 rounded-full text-[11px] font-mono uppercase tracking-wider transition-all bg-noir-800/80 text-zinc-400 hover:text-white border border-noir-roseBorder/40\">\n                Education (2)\n              </button>\n              <button onclick=\"filterTimeline('leadership')\" data-filter=\"leadership\" class=\"timeline-filter px-3.5 py-1.5 rounded-full text-[11px] font-mono uppercase tracking-wider transition-all bg-noir-800/80 text-zinc-400 hover:text-white border border-noir-roseBorder/40\">\n                Leadership (1)\n              </button>\n            </div>\n          </div>\n\n          <!-- ================= ALTERNATING TIMELINE WRAPPER ================= -->\n          <!-- \n            Mobile: Single line on the left.\n            Tablet / Desktop (md+): Central spine with Left & Right alternating cards.\n          -->\n          <div class=\"relative timeline-container py-4\">\n            \n            <!-- Central Vertical Spine Line: Left on mobile, Perfectly centered on md+ -->\n            <div class=\"absolute left-[20px] md:left-1/2 md:-translate-x-1/2 top-4 bottom-6 w-[2px] bg-gradient-to-b from-noir-accent via-rose-700/60 to-transparent\"></div>\n\n            <div class=\"space-y-12 sm:space-y-16\" id=\"milestonesList\">\n\n              <!-- ================= ITEM 01: AUST (LEFT SIDE ON DESKTOP) ================= -->\n              <div class=\"timeline-milestone relative flex flex-col md:flex-row items-center justify-between group\" data-category=\"education\" data-index=\"1\">\n                \n                <!-- Card Container (Left on desktop) -->\n                <div class=\"w-full md:w-[45%] pl-12 md:pl-0 order-2 md:order-1\">\n                  <div class=\"timeline-card-left card-glass border border-noir-roseBorder/50 hover:border-noir-accent/80 rounded-2xl p-5 sm:p-6 shadow-xl transition-all duration-300 hover:shadow-[0_10px_35px_rgba(189,51,76,0.18)]\">\n                    \n                    <div class=\"flex items-center justify-between border-b border-white/5 pb-2.5 mb-3\">\n                      <span class=\"text-[10px] font-mono tracking-widest uppercase px-2.5 py-0.5 rounded-full bg-noir-accent/25 border border-noir-accent/50 text-rose-200\">\n                        2023 &mdash; PRESENT\n                      </span>\n                      <span class=\"font-serif italic text-base text-rose-300/40 font-semibold\">01</span>\n                    </div>\n\n                    <div class=\"flex items-center gap-2 mb-1\">\n                      <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></span>\n                      <p class=\"text-[9px] font-mono uppercase tracking-widest text-emerald-400 font-semibold\">\n                        UNDERGRADUATE / UNIVERSITY\n                      </p>\n                    </div>\n\n                    <h3 class=\"text-xl sm:text-2xl font-display uppercase tracking-wide text-[#f7ede5] leading-tight mb-2\">\n                      Ahsanullah University of Science and Technology<span class=\"text-noir-accent\">.</span>\n                    </h3>\n                    \n                    <p class=\"text-xs sm:text-[13px] text-zinc-400 font-light leading-relaxed\">\n                      B.Sc. in Computer Science & Engineering &middot; Fourth-year student specializing in distributed algorithms, system architecture, and machine intelligence.\n                    </p>\n\n                    <!-- Tag badges -->\n                    <div class=\"mt-4 pt-3 border-t border-white/5 flex flex-wrap gap-1.5\">\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">CSE Dept</span>\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">Dhaka, BD</span>\n                      <span class=\"px-2 py-0.5 rounded bg-noir-accent/10 border border-noir-accent/30 text-[10px] font-mono text-rose-300\">Current</span>\n                    </div>\n                  </div>\n                </div>\n\n                <!-- Central Glowing Node -->\n                <div class=\"absolute left-[20px] -translate-x-1/2 md:left-1/2 md:-translate-x-1/2 top-6 md:top-1/2 md:-translate-y-1/2 z-20 flex items-center justify-center\">\n                  <div class=\"timeline-node w-5 h-5 rounded-full border-2 border-noir-accent bg-noir-950 flex items-center justify-center transition-all duration-500 group-hover:scale-125 node-pulse-active\">\n                    <div class=\"w-2 h-2 rounded-full bg-noir-accent\"></div>\n                  </div>\n                </div>\n\n                <!-- Empty Right Column on Desktop for balance -->\n                <div class=\"hidden md:block w-[45%] order-3 text-left pl-6\">\n                  <div class=\"text-[10px] font-mono tracking-widest text-zinc-500 uppercase\">\n                    MILESTONE // 01\n                  </div>\n                  <div class=\"text-xs font-serif italic text-rose-300/60 mt-1\">\n                    Academic Foundation & Core CS Systems\n                  </div>\n                </div>\n              </div>\n\n              <!-- ================= ITEM 02: BORAQ (RIGHT SIDE ON DESKTOP) ================= -->\n              <div class=\"timeline-milestone relative flex flex-col md:flex-row items-center justify-between group\" data-category=\"experience\" data-index=\"2\">\n                \n                <!-- Left Column on Desktop (Summary metadata) -->\n                <div class=\"hidden md:block w-[45%] order-1 text-right pr-6\">\n                  <div class=\"text-[10px] font-mono tracking-widest text-zinc-500 uppercase\">\n                    MILESTONE // 02\n                  </div>\n                  <div class=\"text-xs font-serif italic text-rose-300/60 mt-1\">\n                    Enterprise Cloud & Scalable Web Architecture\n                  </div>\n                </div>\n\n                <!-- Central Glowing Node -->\n                <div class=\"absolute left-[20px] -translate-x-1/2 md:left-1/2 md:-translate-x-1/2 top-6 md:top-1/2 md:-translate-y-1/2 z-20 flex items-center justify-center\">\n                  <div class=\"timeline-node w-5 h-5 rounded-full border-2 border-rose-900 bg-noir-950 flex items-center justify-center transition-all duration-500 group-hover:scale-125 group-hover:border-noir-accent\">\n                    <div class=\"w-2 h-2 rounded-full bg-rose-700\"></div>\n                  </div>\n                </div>\n\n                <!-- Card Container (Right on desktop) -->\n                <div class=\"w-full md:w-[45%] pl-12 md:pl-0 order-2 md:order-3\">\n                  <div class=\"timeline-card-right card-glass border border-noir-roseBorder/50 hover:border-noir-accent/80 rounded-2xl p-5 sm:p-6 shadow-xl transition-all duration-300 hover:shadow-[0_10px_35px_rgba(189,51,76,0.18)]\">\n                    \n                    <div class=\"flex items-center justify-between border-b border-white/5 pb-2.5 mb-3\">\n                      <span class=\"text-[10px] font-mono tracking-widest uppercase px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10 text-zinc-300\">\n                        REMOTE &middot; 2024 &mdash; NOW\n                      </span>\n                      <span class=\"font-serif italic text-base text-rose-300/40 font-semibold\">02</span>\n                    </div>\n\n                    <div class=\"flex items-center gap-2 mb-1\">\n                      <span class=\"w-1.5 h-1.5 rounded-full bg-rose-400\"></span>\n                      <p class=\"text-[9px] font-mono uppercase tracking-widest text-rose-300 font-semibold\">\n                        INDUSTRY / FULL-STACK\n                      </p>\n                    </div>\n\n                    <h3 class=\"text-xl sm:text-2xl font-display uppercase tracking-wide text-[#f7ede5] leading-tight mb-2\">\n                      Boraq Technologies<span class=\"text-noir-accent\">.</span>\n                    </h3>\n                    \n                    <p class=\"text-xs sm:text-[13px] text-zinc-400 font-light leading-relaxed\">\n                      Software Engineer &middot; Spearheading production React applications, designing resilient Node.js backends, and handling enterprise database pipelines.\n                    </p>\n\n                    <div class=\"mt-4 pt-3 border-t border-white/5 flex flex-wrap gap-1.5\">\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">Next.js / React</span>\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">Node APIs</span>\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">PostgreSQL</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <!-- ================= ITEM 03: DATAPULSE GLOBAL (LEFT SIDE ON DESKTOP) ================= -->\n              <div class=\"timeline-milestone relative flex flex-col md:flex-row items-center justify-between group\" data-category=\"experience\" data-index=\"3\">\n                \n                <!-- Card Container (Left on desktop) -->\n                <div class=\"w-full md:w-[45%] pl-12 md:pl-0 order-2 md:order-1\">\n                  <div class=\"timeline-card-left card-glass border border-noir-roseBorder/50 hover:border-noir-accent/80 rounded-2xl p-5 sm:p-6 shadow-xl transition-all duration-300 hover:shadow-[0_10px_35px_rgba(189,51,76,0.18)]\">\n                    \n                    <div class=\"flex items-center justify-between border-b border-white/5 pb-2.5 mb-3\">\n                      <span class=\"text-[10px] font-mono tracking-widest uppercase px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10 text-zinc-300\">\n                        2023 &mdash; 2024\n                      </span>\n                      <span class=\"font-serif italic text-base text-rose-300/40 font-semibold\">03</span>\n                    </div>\n\n                    <div class=\"flex items-center gap-2 mb-1\">\n                      <span class=\"w-1.5 h-1.5 rounded-full bg-rose-400\"></span>\n                      <p class=\"text-[9px] font-mono uppercase tracking-widest text-rose-300 font-semibold\">\n                        ENGINEERING / BACKEND\n                      </p>\n                    </div>\n\n                    <h3 class=\"text-xl sm:text-2xl font-display uppercase tracking-wide text-[#f7ede5] leading-tight mb-2\">\n                      DataPulse Global<span class=\"text-noir-accent\">.</span>\n                    </h3>\n                    \n                    <p class=\"text-xs sm:text-[13px] text-zinc-400 font-light leading-relaxed\">\n                      Junior Software Engineer &middot; Engineered high-throughput microservices, integrated containerized CI/CD stacks, and maintained analytical pipelines.\n                    </p>\n\n                    <div class=\"mt-4 pt-3 border-t border-white/5 flex flex-wrap gap-1.5\">\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">Go / Golang</span>\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">Docker</span>\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">Microservices</span>\n                    </div>\n                  </div>\n                </div>\n\n                <!-- Central Glowing Node -->\n                <div class=\"absolute left-[20px] -translate-x-1/2 md:left-1/2 md:-translate-x-1/2 top-6 md:top-1/2 md:-translate-y-1/2 z-20 flex items-center justify-center\">\n                  <div class=\"timeline-node w-5 h-5 rounded-full border-2 border-rose-900 bg-noir-950 flex items-center justify-center transition-all duration-500 group-hover:scale-125 group-hover:border-noir-accent\">\n                    <div class=\"w-2 h-2 rounded-full bg-rose-700\"></div>\n                  </div>\n                </div>\n\n                <!-- Balance Right Column -->\n                <div class=\"hidden md:block w-[45%] order-3 text-left pl-6\">\n                  <div class=\"text-[10px] font-mono tracking-widest text-zinc-500 uppercase\">\n                    MILESTONE // 03\n                  </div>\n                  <div class=\"text-xs font-serif italic text-rose-300/60 mt-1\">\n                    High Throughput Pipelines & Microservice Clusters\n                  </div>\n                </div>\n              </div>\n\n              <!-- ================= ITEM 04: ROBOTICS CLUB (RIGHT SIDE ON DESKTOP) ================= -->\n              <div class=\"timeline-milestone relative flex flex-col md:flex-row items-center justify-between group\" data-category=\"leadership\" data-index=\"4\">\n                \n                <!-- Balance Left Column -->\n                <div class=\"hidden md:block w-[45%] order-1 text-right pr-6\">\n                  <div class=\"text-[10px] font-mono tracking-widest text-zinc-500 uppercase\">\n                    MILESTONE // 04\n                  </div>\n                  <div class=\"text-xs font-serif italic text-rose-300/60 mt-1\">\n                    Computer Vision, Autonomous Systems & Hardware\n                  </div>\n                </div>\n\n                <!-- Central Glowing Node -->\n                <div class=\"absolute left-[20px] -translate-x-1/2 md:left-1/2 md:-translate-x-1/2 top-6 md:top-1/2 md:-translate-y-1/2 z-20 flex items-center justify-center\">\n                  <div class=\"timeline-node w-5 h-5 rounded-full border-2 border-rose-900 bg-noir-950 flex items-center justify-center transition-all duration-500 group-hover:scale-125 group-hover:border-noir-accent\">\n                    <div class=\"w-2 h-2 rounded-full bg-rose-700\"></div>\n                  </div>\n                </div>\n\n                <!-- Card Container (Right on desktop) -->\n                <div class=\"w-full md:w-[45%] pl-12 md:pl-0 order-2 md:order-3\">\n                  <div class=\"timeline-card-right card-glass border border-noir-roseBorder/50 hover:border-noir-accent/80 rounded-2xl p-5 sm:p-6 shadow-xl transition-all duration-300 hover:shadow-[0_10px_35px_rgba(189,51,76,0.18)]\">\n                    \n                    <div class=\"flex items-center justify-between border-b border-white/5 pb-2.5 mb-3\">\n                      <span class=\"text-[10px] font-mono tracking-widest uppercase px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10 text-zinc-300\">\n                        2022 &mdash; 2024\n                      </span>\n                      <span class=\"font-serif italic text-base text-rose-300/40 font-semibold\">04</span>\n                    </div>\n\n                    <div class=\"flex items-center gap-2 mb-1\">\n                      <span class=\"w-1.5 h-1.5 rounded-full bg-amber-400\"></span>\n                      <p class=\"text-[9px] font-mono uppercase tracking-widest text-amber-300 font-semibold\">\n                        LEADERSHIP / ROBOTICS\n                      </p>\n                    </div>\n\n                    <h3 class=\"text-xl sm:text-2xl font-display uppercase tracking-wide text-[#f7ede5] leading-tight mb-2\">\n                      AUST Robotics Club<span class=\"text-noir-accent\">.</span>\n                    </h3>\n                    \n                    <p class=\"text-xs sm:text-[13px] text-zinc-400 font-light leading-relaxed\">\n                      Lead of Software & Embedded Systems &middot; Led autonomous Mars Rover software stack, telemetry protocols, OpenCV camera arrays, and brushed motor drivers.\n                    </p>\n\n                    <div class=\"mt-4 pt-3 border-t border-white/5 flex flex-wrap gap-1.5\">\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">Robotics</span>\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">C++ / Python</span>\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">Telemetry</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <!-- ================= ITEM 05: NOTRE DAME COLLEGE (LEFT SIDE ON DESKTOP) ================= -->\n              <div class=\"timeline-milestone relative flex flex-col md:flex-row items-center justify-between group\" data-category=\"education\" data-index=\"5\">\n                \n                <!-- Card Container (Left on desktop) -->\n                <div class=\"w-full md:w-[45%] pl-12 md:pl-0 order-2 md:order-1\">\n                  <div class=\"timeline-card-left card-glass border border-noir-roseBorder/50 hover:border-noir-accent/80 rounded-2xl p-5 sm:p-6 shadow-xl transition-all duration-300 hover:shadow-[0_10px_35px_rgba(189,51,76,0.18)]\">\n                    \n                    <div class=\"flex items-center justify-between border-b border-white/5 pb-2.5 mb-3\">\n                      <span class=\"text-[10px] font-mono tracking-widest uppercase px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10 text-zinc-300\">\n                        2020 &mdash; 2022\n                      </span>\n                      <span class=\"font-serif italic text-base text-rose-300/40 font-semibold\">05</span>\n                    </div>\n\n                    <div class=\"flex items-center gap-2 mb-1\">\n                      <span class=\"w-1.5 h-1.5 rounded-full bg-blue-400\"></span>\n                      <p class=\"text-[9px] font-mono uppercase tracking-widest text-blue-300 font-semibold\">\n                        HIGHER SECONDARY / SCIENCE\n                      </p>\n                    </div>\n\n                    <h3 class=\"text-xl sm:text-2xl font-display uppercase tracking-wide text-[#f7ede5] leading-tight mb-2\">\n                      Notre Dame College<span class=\"text-noir-accent\">.</span>\n                    </h3>\n                    \n                    <p class=\"text-xs sm:text-[13px] text-zinc-400 font-light leading-relaxed\">\n                      Higher Secondary Certificate &middot; Science Division. Developed rigorous analytical reasoning, physics intuition, and competitive programming foundations.\n                    </p>\n\n                    <div class=\"mt-4 pt-3 border-t border-white/5 flex flex-wrap gap-1.5\">\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">Science</span>\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">Dhaka</span>\n                      <span class=\"px-2 py-0.5 rounded bg-noir-800 border border-white/5 text-[10px] font-mono text-zinc-300\">GPA 5.00</span>\n                    </div>\n                  </div>\n                </div>\n\n                <!-- Central Glowing Node -->\n                <div class=\"absolute left-[20px] -translate-x-1/2 md:left-1/2 md:-translate-x-1/2 top-6 md:top-1/2 md:-translate-y-1/2 z-20 flex items-center justify-center\">\n                  <div class=\"timeline-node w-5 h-5 rounded-full border-2 border-rose-900 bg-noir-950 flex items-center justify-center transition-all duration-500 group-hover:scale-125 group-hover:border-noir-accent\">\n                    <div class=\"w-2 h-2 rounded-full bg-rose-700\"></div>\n                  </div>\n                </div>\n\n                <!-- Balance Right Column -->\n                <div class=\"hidden md:block w-[45%] order-3 text-left pl-6\">\n                  <div class=\"text-[10px] font-mono tracking-widest text-zinc-500 uppercase\">\n                    MILESTONE // 05\n                  </div>\n                  <div class=\"text-xs font-serif italic text-rose-300/60 mt-1\">\n                    Science Foundations & Analytical Problem Solving\n                  </div>\n                </div>\n              </div>\n\n            </div>\n          </div>\n        </div>\n\n        <!-- ================= RIGHT AREA: PINNED RESPONSIVE PROFILE ================= -->\n        <!-- \n          * CRITICAL FIX FOR CUT-OFF / FIT ON ANY WINDOWS/LAPTOP SCREEN *\n          - Uses responsive height: max-h-[calc(100vh-5rem)] with overflow-y-auto (custom hidden scrollbar)\n          - Scaled font sizes (text-4xl to 7xl) to ensure no overflow on standard 768p, 1080p or 2K screens.\n          - Perfectly stays pinned during scroll and gracefully releases.\n        -->\n        <div class=\"lg:col-span-5 xl:col-span-4 relative order-1 lg:order-2\">\n          <div class=\"lg:sticky lg:top-20 py-8 lg:py-6 lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto no-scrollbar border-b lg:border-b-0 lg:border-l border-noir-roseBorder/30 lg:pl-8 xl:pl-10 flex flex-col justify-between\">\n            \n            <div class=\"space-y-5 sm:space-y-6\">\n              \n              <!-- Subtle Tag Header -->\n              <div class=\"flex items-center gap-2 text-rose-300/90 font-mono text-[11px] uppercase tracking-widest\">\n                <span class=\"text-noir-accent text-sm font-bold\">&#10038;</span>\n                <span class=\"tracking-[0.2em]\">WHO I AM</span>\n                <span class=\"text-zinc-600\">/</span>\n                <span class=\"text-zinc-400\">THE SHORT VERSION</span>\n              </div>\n\n              <!-- Main Big Responsive Heading (Scaled for all screen sizes) -->\n              <div class=\"leading-none pt-1\">\n                <h2 class=\"text-5xl sm:text-6xl md:text-7xl xl:text-8xl font-display tracking-tight text-[#f5eae2] uppercase m-0 leading-[0.88]\">\n                  BEYOND\n                </h2>\n                <div class=\"flex items-baseline gap-2 mt-1\">\n                  <span class=\"font-serif italic text-3xl sm:text-4xl xl:text-5xl text-rose-200/90 font-normal lowercase tracking-wide\">\n                    the\n                  </span>\n                  <h2 class=\"text-5xl sm:text-6xl md:text-7xl xl:text-8xl font-display tracking-tight text-[#f5eae2] uppercase m-0 leading-[0.88]\">\n                    TITLE<span class=\"text-noir-accent inline-block\">.</span>\n                  </h2>\n                </div>\n              </div>\n\n              <!-- Primary Bio Statement -->\n              <p class=\"text-base sm:text-lg font-serif text-rose-100/90 leading-relaxed\">\n                I’m <span class=\"italic font-bold text-white tracking-wide\">Shajedul Kabir Rafi</span> &mdash; a fourth-year CSE undergraduate at <span class=\"text-white font-medium\">AUST</span> and a software engineer driven by elegant systems and impactful architecture.\n              </p>\n\n              <!-- Secondary Bio Details -->\n              <p class=\"text-xs sm:text-sm text-zinc-400 font-sans leading-relaxed\">\n                From developing distributed backend microservices at <strong class=\"text-zinc-200 font-medium\">DataPulse Global</strong> to building full-stack products at <strong class=\"text-zinc-200 font-medium\">Boraq</strong> and leading embedded autonomy at <strong class=\"text-zinc-200 font-medium\">AUST Robotics</strong>, I craft software that scales reliably.\n              </p>\n\n              <!-- Live Capabilities Card -->\n              <div class=\"p-4 rounded-xl bg-noir-850/90 border border-noir-roseBorder/40 space-y-3\">\n                <div class=\"flex items-center justify-between text-xs font-mono text-noir-muted\">\n                  <span class=\"uppercase tracking-widest text-[10px]\">CURRENT FOCUS</span>\n                  <span class=\"flex items-center gap-1.5 text-emerald-400 text-[10px]\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\"></span> Open for Opportunities\n                  </span>\n                </div>\n\n                <div class=\"flex flex-wrap gap-1.5\">\n                  <span class=\"px-2.5 py-1 rounded bg-noir-800 text-rose-200/90 font-mono text-[10px] border border-white/5\">Go (Golang)</span>\n                  <span class=\"px-2.5 py-1 rounded bg-noir-800 text-rose-200/90 font-mono text-[10px] border border-white/5\">React & Next.js</span>\n                  <span class=\"px-2.5 py-1 rounded bg-noir-800 text-rose-200/90 font-mono text-[10px] border border-white/5\">Node.js</span>\n                  <span class=\"px-2.5 py-1 rounded bg-noir-800 text-rose-200/90 font-mono text-[10px] border border-white/5\">Docker & K8s</span>\n                  <span class=\"px-2.5 py-1 rounded bg-noir-800 text-rose-200/90 font-mono text-[10px] border border-white/5\">PostgreSQL</span>\n                </div>\n              </div>\n\n              <!-- Quick Action Buttons -->\n              <div class=\"pt-2 flex flex-wrap items-center gap-3\">\n                <a href=\"#contact\" class=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-noir-accent to-[#942035] hover:opacity-95 text-white text-xs font-medium uppercase tracking-widest transition-all shadow-[0_4px_20px_rgba(189,51,76,0.3)]\">\n                  <span>Connect With Rafi</span>\n                  <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"></path></svg>\n                </a>\n                \n                <button onclick=\"copyMail()\" id=\"profileCopyBtn\" class=\"px-4 py-2.5 rounded-full border border-noir-roseBorder/60 hover:border-noir-accent text-zinc-300 hover:text-white text-xs font-mono tracking-wider transition-all bg-noir-900/80 flex items-center gap-2\">\n                  <svg class=\"w-3.5 h-3.5 text-noir-accent\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z\"></path></svg>\n                  <span id=\"profileCopyLabel\">Copy Email</span>\n                </button>\n              </div>\n\n              <!-- Timeline Jump Quick-Links -->\n              <div class=\"pt-4 border-t border-white/5\">\n                <p class=\"text-[10px] font-mono uppercase tracking-widest text-zinc-500 mb-2\">QUICK MILESTONE NAV</p>\n                <div class=\"grid grid-cols-2 gap-2 text-[11px] font-mono text-zinc-400\">\n                  <a href=\"#milestonesList\" onclick=\"highlightMilestone(1)\" class=\"hover:text-rose-300 transition-colors flex items-center gap-1.5\">\n                    <span class=\"text-noir-accent\">&bull;</span> AUST ('23-Now)\n                  </a>\n                  <a href=\"#milestonesList\" onclick=\"highlightMilestone(2)\" class=\"hover:text-rose-300 transition-colors flex items-center gap-1.5\">\n                    <span class=\"text-noir-accent\">&bull;</span> Boraq Tech ('24)\n                  </a>\n                  <a href=\"#milestonesList\" onclick=\"highlightMilestone(3)\" class=\"hover:text-rose-300 transition-colors flex items-center gap-1.5\">\n                    <span class=\"text-noir-accent\">&bull;</span> DataPulse ('23)\n                  </a>\n                  <a href=\"#milestonesList\" onclick=\"highlightMilestone(4)\" class=\"hover:text-rose-300 transition-colors flex items-center gap-1.5\">\n                    <span class=\"text-noir-accent\">&bull;</span> Robotics Club\n                  </a>\n                </div>\n              </div>\n\n            </div>\n\n            <!-- Footer note within pinned area -->\n            <div class=\"text-[10px] font-mono text-zinc-600 pt-6 tracking-wider\">\n              LOCATED IN DHAKA &bull; UTC+6\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= SECTION 03: FEATURED CREATIONS ================= -->\n  <section id=\"projects\" class=\"min-h-screen relative py-28 px-5 sm:px-10 bg-noir-950 border-b border-noir-roseBorder/20 grain-overlay\">\n    <div class=\"max-w-6xl mx-auto space-y-12\">\n      <div class=\"flex flex-col md:flex-row md:items-end justify-between border-b border-noir-roseBorder/30 pb-6 gap-4\">\n        <div>\n          <span class=\"text-xs font-mono text-noir-accent tracking-widest uppercase\">02 &mdash; SELECTED PORTFOLIO</span>\n          <h2 class=\"text-5xl sm:text-6xl font-display uppercase tracking-tight text-noir-sand mt-2\">\n            FEATURED WORKS<span class=\"text-noir-accent\">.</span>\n          </h2>\n        </div>\n        <p class=\"text-noir-muted text-xs sm:text-sm max-w-md font-light\">\n          Upon scrolling through all milestones, the pinned profile cleanly flows with the rest of the page.\n        </p>\n      </div>\n\n      <!-- Project Cards Grid -->\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        \n        <div class=\"card-glass border border-noir-roseBorder/40 p-6 rounded-2xl hover:border-noir-accent transition-all duration-300 group\">\n          <div class=\"h-44 rounded-xl bg-gradient-to-tr from-rose-950/40 to-noir-850 border border-white/5 flex items-center justify-center text-3xl font-display text-rose-300/30 group-hover:text-noir-accent/80 transition-colors\">\n            01 / AI TRIAGE\n          </div>\n          <h3 class=\"text-xl font-display text-noir-sand uppercase tracking-wide mt-4\">Disaster Response AI</h3>\n          <p class=\"text-xs text-zinc-400 mt-2 leading-relaxed\">Automated emergency triage system leveraging LLMs, geofencing, and real-time GIS spatial mapping.</p>\n        </div>\n\n        <div class=\"card-glass border border-noir-roseBorder/40 p-6 rounded-2xl hover:border-noir-accent transition-all duration-300 group\">\n          <div class=\"h-44 rounded-xl bg-gradient-to-tr from-rose-950/40 to-noir-850 border border-white/5 flex items-center justify-center text-3xl font-display text-rose-300/30 group-hover:text-noir-accent/80 transition-colors\">\n            02 / TELEMETRY\n          </div>\n          <h3 class=\"text-xl font-display text-noir-sand uppercase tracking-wide mt-4\">Autonomous Ground Station</h3>\n          <p class=\"text-xs text-zinc-400 mt-2 leading-relaxed\">High-performance React + WebSockets dashboard visualizing telemetry and sensor matrices.</p>\n        </div>\n\n        <div class=\"card-glass border border-noir-roseBorder/40 p-6 rounded-2xl hover:border-noir-accent transition-all duration-300 group\">\n          <div class=\"h-44 rounded-xl bg-gradient-to-tr from-rose-950/40 to-noir-850 border border-white/5 flex items-center justify-center text-3xl font-display text-rose-300/30 group-hover:text-noir-accent/80 transition-colors\">\n            03 / CLOUD PIPELINE\n          </div>\n          <h3 class=\"text-xl font-display text-noir-sand uppercase tracking-wide mt-4\">Distributed Ledger Gateway</h3>\n          <p class=\"text-xs text-zinc-400 mt-2 leading-relaxed\">A resilient Golang microservice cluster handling multi-tenant transactional message streams.</p>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= SECTION 04: FOOTER / CONTACT ================= -->\n  <footer id=\"contact\" class=\"py-20 px-6 bg-[#050103] border-t border-noir-roseBorder/30 text-center relative\">\n    <div class=\"max-w-4xl mx-auto space-y-6\">\n      <div class=\"inline-block px-3 py-1 rounded-full bg-noir-850 border border-noir-roseBorder text-[10px] font-mono tracking-widest text-rose-300 uppercase\">\n        Let's Connect\n      </div>\n      <h3 class=\"text-4xl sm:text-5xl font-display uppercase tracking-widest text-noir-sand\">\n        LET'S BUILD SOMETHING EXTRAORDINARY<span class=\"text-noir-accent\">.</span>\n      </h3>\n      <p class=\"text-xs text-noir-muted font-mono tracking-wider\">\n        shajedul.rafi@aust.edu &bull; DHAKA, BANGLADESH\n      </p>\n\n      <div class=\"pt-4 flex items-center justify-center gap-3\">\n        <button onclick=\"copyMail()\" class=\"px-6 py-2.5 rounded-full bg-noir-accent hover:bg-noir-glow text-white text-xs font-mono tracking-wider transition-all shadow-[0_0_20px_rgba(189,51,76,0.4)]\">\n          Copy Email Address\n        </button>\n      </div>\n\n      <div class=\"text-[11px] text-zinc-600 font-mono tracking-widest pt-8 border-t border-white/5\">\n        &copy; 2026 SHAJEDUL KABIR RAFI. ALL RIGHTS RESERVED.\n      </div>\n    </div>\n  </footer>\n\n  <!-- ================= INTERACTIVE JAVASCRIPT LOGIC ================= -->\n  <script>\n    // Copy Email helper with visual feedback\n    function copyMail() {\n      const email = 'shajedul.rafi@aust.edu';\n      const dummyInput = document.createElement('input');\n      dummyInput.value = email;\n      document.body.appendChild(dummyInput);\n      dummyInput.select();\n      document.execCommand('copy');\n      document.body.removeChild(dummyInput);\n\n      const navLabel = document.getElementById('navCopyLabel');\n      const profileLabel = document.getElementById('profileCopyLabel');\n\n      if (navLabel) navLabel.innerText = 'Copied!';\n      if (profileLabel) profileLabel.innerText = 'Copied to Clipboard!';\n\n      setTimeout(() => {\n        if (navLabel) navLabel.innerText = 'Copy Email';\n        if (profileLabel) profileLabel.innerText = 'Copy Email';\n      }, 2200);\n    }\n\n    // Filter milestones by category\n    function filterTimeline(category) {\n      const items = document.querySelectorAll('.timeline-milestone');\n      const buttons = document.querySelectorAll('.timeline-filter');\n\n      // Update button visual styles\n      buttons.forEach(btn => {\n        if (btn.getAttribute('data-filter') === category) {\n          btn.className = \"timeline-filter active-filter px-3.5 py-1.5 rounded-full text-[11px] font-mono uppercase tracking-wider transition-all bg-noir-accent text-white border border-noir-accent shadow-[0_0_15px_rgba(189,51,76,0.3)]\";\n        } else {\n          btn.className = \"timeline-filter px-3.5 py-1.5 rounded-full text-[11px] font-mono uppercase tracking-wider transition-all bg-noir-800/80 text-zinc-400 hover:text-white border border-noir-roseBorder/40\";\n        }\n      });\n\n      // Filter timeline nodes\n      items.forEach(item => {\n        const itemCat = item.getAttribute('data-category');\n        if (category === 'all' || itemCat === category) {\n          item.style.display = 'flex';\n        } else {\n          item.style.display = 'none';\n        }\n      });\n    }\n\n    // Quick scroll & pulse to a specific milestone\n    function highlightMilestone(index) {\n      const target = document.querySelector(`.timeline-milestone[data-index=\"${index}\"]`);\n      if (target) {\n        target.scrollIntoView({ behavior: 'smooth', block: 'center' });\n        const node = target.querySelector('.timeline-node');\n        if (node) {\n          node.classList.add('node-pulse-active');\n        }\n      }\n    }\n\n    // Scroll Observer: Triggers slide-in from left and right alternately + activates spine dots\n    document.addEventListener('DOMContentLoaded', () => {\n      const milestones = document.querySelectorAll('.timeline-milestone');\n\n      const observer = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n          const card = entry.target.querySelector('.timeline-card-left, .timeline-card-right');\n          const node = entry.target.querySelector('.timeline-node');\n\n          if (entry.isIntersecting) {\n            if (card) card.classList.add('timeline-card-visible');\n            if (node) {\n              node.classList.add('node-pulse-active');\n              node.classList.remove('border-rose-900');\n            }\n          } else {\n            // When scrolled way past, dim down node pulse\n            if (entry.boundingClientRect.top < 0 && node) {\n              node.classList.remove('node-pulse-active');\n            }\n          }\n        });\n      }, {\n        rootMargin: '-10% 0px -20% 0px',\n        threshold: 0.15\n      });\n\n      milestones.forEach(item => observer.observe(item));\n    });\n  </script>\n</body>\n</html>",
