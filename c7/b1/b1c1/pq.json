  {
    "id": "pq1",
    "question": "‘অপরিচিতা’ গল্পে অনুজের নাম কী?",
    "answer": "<!DOCTYPE html>\n<html lang=\"en\" class=\"h-full\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ABC Phonics Chant for Children | Sounds and Actions from A to Z</title>\n  \n  <!-- Tailwind CSS -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  \n  <!-- Google Fonts -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap\" rel=\"stylesheet\">\n  \n  <!-- Lucide Icons -->\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n\n  <script>\n    tailwind.config = {\n      darkMode: 'class',\n      theme: {\n        extend: {\n          fontFamily: {\n            siliguri: ['\"Hind Siliguri\"', 'sans-serif'],\n            mono: ['\"JetBrains Mono\"', 'monospace'],\n            sans: ['\"Plus Jakarta Sans\"', 'sans-serif']\n          },\n          colors: {\n            brand: {\n              400: '#22d3ee',\n              500: '#06b6d4',\n              600: '#0891b2',\n            }\n          }\n        }\n      }\n    }\n  </script>\n\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    body {\n      font-family: 'Plus Jakarta Sans', 'Hind Siliguri', sans-serif;\n    }\n\n    /* Custom Scrollbar for Light and Dark Modes */\n    .custom-scroll {\n      overflow-y: auto;\n      overflow-x: hidden;\n    }\n    .custom-scroll::-webkit-scrollbar {\n      width: 5px;\n      height: 5px;\n    }\n    .custom-scroll::-webkit-scrollbar-track {\n      background: transparent;\n    }\n    .custom-scroll::-webkit-scrollbar-thumb {\n      background: #cbd5e1;\n      border-radius: 9999px;\n    }\n    .dark .custom-scroll::-webkit-scrollbar-thumb {\n      background: #334155;\n    }\n    .custom-scroll::-webkit-scrollbar-thumb:hover {\n      background: #94a3b8;\n    }\n    .dark .custom-scroll::-webkit-scrollbar-thumb:hover {\n      background: #475569;\n    }\n\n    /* TOC Active State for Light & Dark */\n    .toc-item-link {\n      border-left: 3px solid transparent;\n      transition: all 0.15s ease-in-out;\n    }\n    .toc-item-link:hover {\n      background: rgba(224, 242, 254, 0.7);\n      color: #0284c7;\n      border-left-color: #0284c7;\n    }\n    .dark .toc-item-link:hover {\n      background: rgba(30, 41, 59, 0.7);\n      color: #38bdf8;\n      border-left-color: #38bdf8;\n    }\n    .toc-item-link.active {\n      background: rgba(6, 182, 212, 0.14) !important;\n      color: #0891b2 !important;\n      font-weight: 700;\n      border-left-color: #06b6d4 !important;\n    }\n    .dark .toc-item-link.active {\n      background: rgba(6, 182, 212, 0.12) !important;\n      color: #22d3ee !important;\n      border-left-color: #06b6d4 !important;\n    }\n\n    /* 16:9 Video docked frame */\n    .video-docked-box {\n      width: 100% !important;\n      aspect-ratio: 16 / 9;\n      height: auto !important;\n      position: relative;\n      flex-shrink: 0;\n      border-radius: 0.75rem;\n      overflow: hidden;\n      background: #000;\n    }\n\n    /* Floating Video Mode */\n    .video-floating-mode {\n      position: fixed !important;\n      z-index: 99999 !important;\n      width: 380px !important;\n      max-width: 90vw !important;\n      aspect-ratio: 16 / 9;\n      height: auto !important;\n      box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.45), 0 0 20px rgba(6, 182, 212, 0.35) !important;\n      border: 1px solid rgba(6, 182, 212, 0.7) !important;\n      border-radius: 0.875rem !important;\n      background: #000 !important;\n      overflow: hidden;\n    }\n\n    /* Resizer Divider between Sidebar and Viewport */\n    .resizer-divider {\n      width: 6px;\n      margin-left: -3px;\n      margin-right: -3px;\n      cursor: col-resize;\n      position: relative;\n      z-index: 45;\n      user-select: none;\n      transition: background-color 0.2s;\n    }\n    .resizer-divider:hover,\n    .resizer-divider.dragging {\n      background-color: #06b6d4 !important;\n    }\n    .resizer-divider::after {\n      content: '';\n      position: absolute;\n      top: 0;\n      bottom: 0;\n      left: -4px;\n      right: -4px;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen lg:h-full lg:overflow-hidden select-text antialiased transition-colors duration-200\">\n\n  <div class=\"w-full min-h-screen lg:h-full flex flex-col overflow-hidden\">\n\n    <!-- Header Topbar -->\n    <header class=\"h-14 bg-white/95 dark:bg-slate-900/90 border-b border-slate-200 dark:border-slate-800/80 px-4 sm:px-6 flex items-center justify-between shrink-0 z-40 backdrop-blur-md transition-colors duration-200\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-8 h-8 rounded-lg bg-cyan-500/15 dark:bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30 flex items-center justify-center font-mono font-bold text-xs\">\n          ABC\n        </div>\n        <div>\n          <h1 class=\"text-sm font-bold text-slate-900 dark:text-white font-sans tracking-tight\">ABC Phonics Chant for Children</h1>\n          <p class=\"text-[11px] text-slate-500 dark:text-slate-400 hidden sm:block\">Sounds and Actions from A to Z</p>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-2.5\">\n        <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-mono font-semibold bg-cyan-100 dark:bg-cyan-950/80 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800/50\">\n          <i data-lucide=\"music\" class=\"w-3.5 h-3.5\"></i> PHONICS CHANT\n        </span>\n        <span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-mono font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 hidden md:inline-flex\">\n          <i data-lucide=\"volume-2\" class=\"w-3.5 h-3.5 text-emerald-500 dark:text-emerald-400\"></i> A to Z Sounds\n        </span>\n\n        <!-- Light / Dark Theme Toggle Button -->\n        <button id=\"theme-toggle-btn\" type=\"button\" onclick=\"toggleTheme()\" title=\"Switch Light/Dark Mode\"\n                class=\"w-8 h-8 rounded-lg flex items-center justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-amber-400 border border-slate-200 dark:border-slate-700 transition-all duration-150 active:scale-95 cursor-pointer\">\n          <i id=\"theme-icon\" data-lucide=\"moon\" class=\"w-4 h-4\"></i>\n        </button>\n      </div>\n    </header>\n\n    <!-- Main Workspace -->\n    <div id=\"app-workspace\" class=\"flex-1 flex flex-col lg:flex-row min-h-0 w-full overflow-hidden relative\">\n\n      <!-- Sidebar: 30% Width by Default -->\n      <aside id=\"toc-panel\" class=\"w-full lg:w-[30%] h-auto lg:h-full bg-white dark:bg-slate-950 flex flex-col p-3 shrink-0 z-30 custom-scroll border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-slate-800/80 transition-colors duration-200\" style=\"min-width: 220px; max-width: 55vw;\">\n        \n        <!-- Video Docking Slot -->\n        <div id=\"video-dock-anchor\" class=\"w-full shrink-0 flex flex-col items-center justify-center transition-all duration-300 mb-3\">\n          \n          <div id=\"master-video-card\" class=\"video-docked-box border border-slate-300 dark:border-slate-800 shadow-sm transition-all duration-200\">\n            \n            <!-- Floating Drag Bar -->\n            <div id=\"video-drag-handle-bar\" class=\"hidden absolute top-0 inset-x-0 h-7 z-40 bg-gradient-to-b from-slate-950/90 to-transparent flex items-center px-2 cursor-grab active:cursor-grabbing select-none\">\n              <span class=\"text-[10px] font-mono text-cyan-300 flex items-center gap-1 pointer-events-none drop-shadow\">\n                <i data-lucide=\"grip-horizontal\" class=\"w-3.5 h-3.5\"></i> Drag Video\n              </span>\n            </div>\n\n            <!-- Dragging Shield Overlay -->\n            <div id=\"drag-shield\" class=\"hidden absolute inset-0 z-35 bg-transparent\"></div>\n\n            <!-- Pin / Unpin Button -->\n            <button id=\"pin-toggle-btn\" type=\"button\" onclick=\"togglePinVideo(event)\" title=\"Pin / Unpin Video\" \n                    class=\"absolute top-1.5 right-1.5 z-50 w-6 h-6 rounded bg-slate-900/80 hover:bg-cyan-500 text-slate-200 hover:text-slate-950 border border-slate-600 hover:border-cyan-400 flex items-center justify-center shadow-md backdrop-blur-md transition-all active:scale-90 cursor-pointer\">\n              <i id=\"pin-icon\" data-lucide=\"pin\" class=\"w-3.5 h-3.5 fill-current\"></i>\n            </button>\n\n            <!-- Video Frame (16:9) -->\n            <iframe \n              id=\"main-video-iframe\"\n              src=\"https://www.facebook.com/plugins/video.php?href=https%3A%2F%2Fwww.facebook.com%2Freel%2F944354501696845&show_text=false\" \n              class=\"w-full h-full block relative z-10\" \n              style=\"border:none; overflow:hidden;\" \n              allowfullscreen=\"true\" \n              allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\">\n            </iframe>\n\n          </div>\n        </div>\n\n        <!-- Table of Contents (TOC) -->\n        <nav id=\"toc-nav-wrapper\" class=\"w-full text-xs space-y-3\">\n          <div class=\"flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800/80\">\n            <span class=\"text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-mono flex items-center gap-1.5\">\n              <i data-lucide=\"list-ordered\" class=\"w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400\"></i> Table of Contents\n            </span>\n            <span class=\"text-[10px] font-mono text-cyan-700 dark:text-cyan-400 bg-cyan-100 dark:bg-cyan-950/60 px-2 py-0.5 rounded-full border border-cyan-200 dark:border-cyan-800/50\">6 Sections</span>\n          </div>\n\n          <!-- Group 1: A - C -->\n          <div class=\"space-y-1\">\n            <div class=\"text-[10px] font-bold uppercase text-slate-400 dark:text-slate-500 font-mono tracking-wider px-2\">\n              1. Letters A to C\n            </div>\n            <ul class=\"space-y-0.5\">\n              <li>\n                <a href=\"#section-a\" data-target=\"section-a\" class=\"toc-item-link block px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 text-[13px]\">\n                  Letter A (Apple)\n                </a>\n              </li>\n              <li>\n                <a href=\"#section-b-c\" data-target=\"section-b-c\" class=\"toc-item-link block px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 text-[13px]\">\n                  Letters B &amp; C (Ball, Cat)\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          <!-- Group 2: D - F -->\n          <div class=\"space-y-1\">\n            <div class=\"text-[10px] font-bold uppercase text-indigo-600 dark:text-indigo-400 font-mono tracking-wider px-2\">\n              2. Letters D to F\n            </div>\n            <ul class=\"space-y-0.5\">\n              <li>\n                <a href=\"#section-d-f\" data-target=\"section-d-f\" class=\"toc-item-link block px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 text-[13px]\">\n                  Letters D, E &amp; F (Dog, Elephant)\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          <!-- Group 3: G - I -->\n          <div class=\"space-y-1\">\n            <div class=\"text-[10px] font-bold uppercase text-emerald-600 dark:text-emerald-400 font-mono tracking-wider px-2\">\n              3. Letters G to I\n            </div>\n            <ul class=\"space-y-0.5\">\n              <li>\n                <a href=\"#section-g-i\" data-target=\"section-g-i\" class=\"toc-item-link block px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 text-[13px]\">\n                  Letters G, H &amp; I (Hat, Igloo)\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          <!-- Group 4: Phonetic / Arabic Script Chants -->\n          <div class=\"space-y-1\">\n            <div class=\"text-[10px] font-bold uppercase text-cyan-600 dark:text-cyan-400 font-mono tracking-wider px-2\">\n              4. Intermediate Chant Sequences\n            </div>\n            <ul class=\"space-y-0.5\">\n              <li>\n                <a href=\"#section-chants-part1\" data-target=\"section-chants-part1\" class=\"toc-item-link block px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 text-[13px]\">\n                  Chant Repetitions (إ, ج, جوس, ك)\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          <!-- Group 5: L - R -->\n          <div class=\"space-y-1\">\n            <div class=\"text-[10px] font-bold uppercase text-amber-600 dark:text-amber-400 font-mono tracking-wider px-2\">\n              5. Letters L to R\n            </div>\n            <ul class=\"space-y-0.5\">\n              <li>\n                <a href=\"#section-l-r\" data-target=\"section-l-r\" class=\"toc-item-link block px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 text-[13px]\">\n                  Lion, Monkey, Nose, Pig, Queen\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          <!-- Group 6: S - Z -->\n          <div class=\"space-y-1\">\n            <div class=\"text-[10px] font-bold uppercase text-rose-600 dark:text-rose-400 font-mono tracking-wider px-2\">\n              6. Letters S to Z\n            </div>\n            <ul class=\"space-y-0.5\">\n              <li>\n                <a href=\"#section-s-w\" data-target=\"section-s-w\" class=\"toc-item-link block px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-300 text-[13px]\">\n                  Sun, Train, Umbrella, Van, Watch\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          <div class=\"pt-3 pb-2 border-t border-slate-200 dark:border-slate-800/80\">\n            <div class=\"p-2.5 rounded-xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-[11px] text-slate-600 dark:text-slate-400 flex items-center justify-between\">\n              <span class=\"flex items-center gap-1.5\">\n                <i data-lucide=\"check\" class=\"w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400\"></i> Smooth Scroll Active\n              </span>\n              <span class=\"font-mono text-[10px] text-cyan-700 dark:text-cyan-400 font-semibold\">30% Sidebar</span>\n            </div>\n          </div>\n        </nav>\n      </aside>\n\n      <!-- Drag Resizer Divider -->\n      <div id=\"drag-resizer\" class=\"hidden lg:block resizer-divider bg-slate-300 dark:bg-slate-800 hover:bg-cyan-500\"></div>\n\n      <!-- Main Viewport -->\n      <main id=\"doc-viewport\" class=\"flex-1 h-full overflow-y-auto custom-scroll p-5 sm:p-8 lg:p-12 relative z-10 bg-slate-50 dark:bg-slate-950 transition-colors duration-200\">\n        <article class=\"w-full space-y-12 pb-28 max-w-4xl mx-auto\">\n\n          <!-- Section 1: Overview & Letter A -->\n          <section id=\"section-a\" class=\"space-y-4 pt-1\">\n            <div class=\"flex flex-wrap items-center gap-2\">\n              <span class=\"inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-100 dark:bg-cyan-950/70 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800/60 font-mono\">\n                <i data-lucide=\"book-open\" class=\"w-3 h-3\"></i> PHONICS DOCUMENT\n              </span>\n              <span class=\"text-xs font-mono text-slate-500 dark:text-slate-400\">Sounds and Actions from A to Z</span>\n            </div>\n\n            <h1 class=\"text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight font-sans\">\n              ABC Phonics Chant for Children: <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-teal-500 dark:from-cyan-400 dark:to-teal-300\">Sounds and Actions from A to Z</span>\n            </h1>\n\n            <div class=\"p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-cyan-900/40 shadow-sm space-y-3\">\n              <div class=\"flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2.5\">\n                <h3 class=\"text-base font-bold text-cyan-700 dark:text-cyan-400 font-sans\">Chant Sequence: A</h3>\n                <span class=\"text-[11px] font-mono bg-cyan-100 dark:bg-cyan-950 text-cyan-800 dark:text-cyan-300 px-2 py-0.5 rounded-full border border-cyan-200 dark:border-cyan-800/60\">Letter Sound</span>\n              </div>\n              <p class=\"text-base sm:text-lg font-mono font-medium text-slate-800 dark:text-slate-100 leading-relaxed tracking-wide\">\n                A a a a a a a a a\n              </p>\n              <div class=\"p-4 rounded-xl bg-slate-50 dark:bg-slate-900/90 border-l-4 border-cyan-500 text-sm sm:text-base font-medium text-slate-700 dark:text-slate-200 leading-relaxed shadow-sm\">\n                Apple, apple, a, a, a.\n              </div>\n            </div>\n          </section>\n\n          <!-- Section 2: Letters B & C -->\n          <section id=\"section-b-c\" class=\"space-y-6\">\n            <div class=\"flex items-center gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3\">\n              <div class=\"p-2 rounded-lg bg-cyan-500/10 text-cyan-600 dark:text-cyan-400\">\n                <i data-lucide=\"music-2\" class=\"w-5 h-5\"></i>\n              </div>\n              <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans\">Letters B &amp; C</h2>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-cyan-500/40 transition-colors space-y-2.5 shadow-sm\">\n                <div class=\"flex items-center justify-between text-cyan-700 dark:text-cyan-400 font-bold font-sans\">\n                  <span class=\"flex items-center gap-2\"><i data-lucide=\"disc\" class=\"w-4 h-4\"></i> Letter B</span>\n                  <span class=\"text-xs font-mono text-slate-400\">Chant</span>\n                </div>\n                <p class=\"text-sm font-mono text-slate-600 dark:text-slate-300 leading-relaxed font-semibold\">\n                  B b b b b b b\n                </p>\n                <p class=\"text-sm text-slate-700 dark:text-slate-200 font-medium\">\n                  Ball, ball, b, b, b.\n                </p>\n              </div>\n\n              <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/40 transition-colors space-y-2.5 shadow-sm\">\n                <div class=\"flex items-center justify-between text-emerald-700 dark:text-emerald-400 font-bold font-sans\">\n                  <span class=\"flex items-center gap-2\"><i data-lucide=\"disc\" class=\"w-4 h-4\"></i> Letter C</span>\n                  <span class=\"text-xs font-mono text-slate-400\">Chant</span>\n                </div>\n                <p class=\"text-sm font-mono text-slate-600 dark:text-slate-300 leading-relaxed font-semibold\">\n                  C c c c c c c\n                </p>\n                <p class=\"text-sm text-slate-700 dark:text-slate-200 font-medium\">\n                  Cat, cat, c, c, c.\n                </p>\n              </div>\n            </div>\n          </section>\n\n          <!-- Section 3: Letters D to F -->\n          <section id=\"section-d-f\" class=\"space-y-6\">\n            <div class=\"flex items-center gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3\">\n              <div class=\"p-2 rounded-lg bg-indigo-500/10 text-indigo-600 dark:text-indigo-400\">\n                <i data-lucide=\"layers\" class=\"w-5 h-5\"></i>\n              </div>\n              <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans\">Letters D, E &amp; F</h2>\n            </div>\n\n            <div class=\"space-y-3.5\">\n              <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 flex gap-4 items-start shadow-sm\">\n                <div class=\"w-8 h-8 rounded-xl bg-cyan-500/15 dark:bg-cyan-500/20 text-cyan-700 dark:text-cyan-400 flex items-center justify-center font-mono font-bold shrink-0 text-sm\">D</div>\n                <div class=\"space-y-1\">\n                  <h4 class=\"text-base font-bold text-slate-900 dark:text-white\">D D D D D D D D D</h4>\n                  <p class=\"text-sm text-slate-600 dark:text-slate-300\">Dog, dog, D, D, D, E, E, E, E, E, E, E, E.</p>\n                </div>\n              </div>\n\n              <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 flex gap-4 items-start shadow-sm\">\n                <div class=\"w-8 h-8 rounded-xl bg-teal-500/15 dark:bg-teal-500/20 text-teal-700 dark:text-teal-400 flex items-center justify-center font-mono font-bold shrink-0 text-sm\">E</div>\n                <div class=\"space-y-1\">\n                  <h4 class=\"text-base font-bold text-slate-900 dark:text-white\">Elephant, elephant</h4>\n                  <p class=\"text-sm text-slate-600 dark:text-slate-300\">Elephant, elephant, E, E, E, F, F, F, F, F, F, F, F.</p>\n                </div>\n              </div>\n            </div>\n          </section>\n\n          <!-- Section 4: Letters G to I -->\n          <section id=\"section-g-i\" class=\"space-y-6\">\n            <div class=\"flex items-center gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3\">\n              <div class=\"p-2 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400\">\n                <i data-lucide=\"sparkles\" class=\"w-5 h-5\"></i>\n              </div>\n              <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans\">Letters G, H &amp; I</h2>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-2 shadow-sm\">\n                <span class=\"text-[11px] font-mono uppercase text-emerald-600 dark:text-emerald-400 font-bold\">Letters G &amp; H</span>\n                <p class=\"text-base font-bold text-slate-900 dark:text-white\">G G G G G G G G H</p>\n                <p class=\"text-sm text-slate-600 dark:text-slate-300 font-medium\">H, H, Hat, Hat.</p>\n              </div>\n\n              <div class=\"p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-2 shadow-sm\">\n                <span class=\"text-[11px] font-mono uppercase text-cyan-600 dark:text-cyan-400 font-bold\">Letter I</span>\n                <p class=\"text-base font-bold text-slate-900 dark:text-white\">I, I, I, I, I, I, I</p>\n                <p class=\"text-sm text-slate-600 dark:text-slate-300 font-medium\">Iglue, Iglue.</p>\n              </div>\n            </div>\n          </section>\n\n          <!-- Section 5: Phonetic Chant Sequences (Arabic Transcriptions) -->\n          <section id=\"section-chants-part1\" class=\"space-y-4\">\n            <div class=\"flex items-center gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3\">\n              <div class=\"p-2 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400\">\n                <i data-lucide=\"mic\" class=\"w-5 h-5\"></i>\n              </div>\n              <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans\">Chant Repetitions &amp; Phonetic Calls</h2>\n            </div>\n\n            <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n              <div class=\"p-4 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-center space-y-2 shadow-sm\">\n                <span class=\"w-7 h-7 rounded-full bg-cyan-100 dark:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 inline-flex items-center justify-center text-xs font-mono font-bold\">1</span>\n                <h5 class=\"text-lg font-bold text-slate-900 dark:text-white\">إ.</h5>\n                <p class=\"text-xs text-slate-500 dark:text-slate-400 font-mono\">إ. إ. إ.</p>\n              </div>\n              <div class=\"p-4 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-center space-y-2 shadow-sm\">\n                <span class=\"w-7 h-7 rounded-full bg-cyan-100 dark:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 inline-flex items-center justify-center text-xs font-mono font-bold\">2</span>\n                <h5 class=\"text-lg font-bold text-slate-900 dark:text-white\">ج.</h5>\n                <p class=\"text-xs text-slate-500 dark:text-slate-400 font-mono\">ج. ج. ج.</p>\n              </div>\n              <div class=\"p-4 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-center space-y-2 shadow-sm\">\n                <span class=\"w-7 h-7 rounded-full bg-cyan-100 dark:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 inline-flex items-center justify-center text-xs font-mono font-bold\">3</span>\n                <h5 class=\"text-lg font-bold text-slate-900 dark:text-white\">جوس.</h5>\n                <p class=\"text-xs text-slate-500 dark:text-slate-400 font-mono\">جوس. جوس. ج. ج. ج.</p>\n              </div>\n              <div class=\"p-4 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-center space-y-2 shadow-sm\">\n                <span class=\"w-7 h-7 rounded-full bg-cyan-100 dark:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 inline-flex items-center justify-center text-xs font-mono font-bold\">4</span>\n                <h5 class=\"text-lg font-bold text-slate-900 dark:text-white\">ك.</h5>\n                <p class=\"text-xs text-slate-500 dark:text-slate-400 font-mono\">ك. ك. ك. ك. ك. ك. ك. ك.</p>\n              </div>\n            </div>\n          </section>\n\n          <!-- Section 6: Letters L to R -->\n          <section id=\"section-l-r\" class=\"space-y-4\">\n            <div class=\"flex items-center gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3\">\n              <div class=\"p-2 rounded-lg bg-cyan-500/10 text-cyan-600 dark:text-cyan-400\">\n                <i data-lucide=\"align-left\" class=\"w-5 h-5\"></i>\n              </div>\n              <h2 class=\"text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans\">Letters L to R Chants</h2>\n            </div>\n\n            <div class=\"p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-4 shadow-sm\">\n              <div class=\"p-4 rounded-xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 font-mono text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed\">\n                Lion, lion, l, l, l, m, m, m, m, m, m, monkey, monkey, m, m, m, n, n, n, m, m, m, nose, nose, m, m, m, o, o, o, o, o, o,\n              </div>\n              <div class=\"p-4 rounded-xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 font-mono text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed\">\n                O, o, o. B, b, b. P, p, p. Pig, pig. P, p, p. Q, q, q. Q, q, q. Queen, queen. Q, q, q. R, r, r.\n              </div>\n            </div>\n          </section>\n\n          <!-- Section 7: Letters S to W & Ending -->\n          <section id=\"section-s-w\" class=\"p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-100 to-white dark:from-slate-900 dark:to-slate-950 border border-slate-200 dark:border-cyan-800/50 space-y-5 shadow-sm\">\n            <div class=\"flex items-center gap-2.5 text-cyan-700 dark:text-cyan-400 font-bold font-sans text-lg border-b border-slate-200 dark:border-slate-800 pb-3\">\n              <i data-lucide=\"sparkles\" class=\"w-6 h-6\"></i>\n              Letters S to Z\n            </div>\n            \n            <div class=\"space-y-3 font-mono text-sm sm:text-base text-slate-700 dark:text-slate-200\">\n              <p class=\"font-semibold text-slate-900 dark:text-white\">Sun sun. Train train.</p>\n              <p>U U U U U U U U U Umbrella umbrella</p>\n              <p>V V V V V V V V Van Van V</p>\n              <p>V, V, W, W, W, Watch, Watch, W, W, W.</p>\n              <p class=\"text-lg font-bold text-cyan-600 dark:text-cyan-400\">أه.</p>\n            </div>\n          </section>\n\n        </article>\n      </main>\n\n    </div>\n  </div>\n\n  <!-- JavaScript Controller -->\n  <script>\n    // ==========================================\n    // Theme Controller (Light/Dark Switch with LocalStorage)\n    // ==========================================\n    function applyTheme(isDark) {\n      const htmlEl = document.documentElement;\n      const themeIcon = document.getElementById('theme-icon');\n      \n      if (isDark) {\n        htmlEl.classList.add('dark');\n        if (themeIcon) themeIcon.setAttribute('data-lucide', 'sun');\n      } else {\n        htmlEl.classList.remove('dark');\n        if (themeIcon) themeIcon.setAttribute('data-lucide', 'moon');\n      }\n      lucide.createIcons();\n    }\n\n    function toggleTheme() {\n      const isDark = document.documentElement.classList.contains('dark');\n      const nextThemeIsDark = !isDark;\n      localStorage.setItem('theme_preference', nextThemeIsDark ? 'dark' : 'light');\n      applyTheme(nextThemeIsDark);\n    }\n\n    // Default initialization\n    (function initTheme() {\n      const saved = localStorage.getItem('theme_preference');\n      const isDark = saved === 'dark';\n      applyTheme(isDark);\n    })();\n\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      lucide.createIcons();\n\n      // ==========================================\n      // 1. Smooth Scrolling & TOC Navigation\n      // ==========================================\n      const navLinks = document.querySelectorAll(\"#toc-nav-wrapper a.toc-item-link\");\n      const docViewport = document.getElementById(\"doc-viewport\");\n      const appWorkspace = document.getElementById(\"app-workspace\");\n\n      const isDesktop = () => window.innerWidth >= 1024;\n\n      navLinks.forEach(link => {\n        link.addEventListener(\"click\", function(e) {\n          e.preventDefault();\n          const targetId = this.getAttribute(\"data-target\");\n          const targetEl = document.getElementById(targetId);\n          if (!targetEl) return;\n\n          if (isDesktop()) {\n            const containerRect = docViewport.getBoundingClientRect();\n            const targetRect = targetEl.getBoundingClientRect();\n            const offsetTop = targetRect.top - containerRect.top + docViewport.scrollTop - 20;\n\n            docViewport.scrollTo({\n              top: offsetTop,\n              behavior: \"smooth\"\n            });\n          } else {\n            const containerRect = appWorkspace.getBoundingClientRect();\n            const targetRect = targetEl.getBoundingClientRect();\n            const offsetTop = targetRect.top - containerRect.top + appWorkspace.scrollTop - 20;\n\n            appWorkspace.scrollTo({\n              top: offsetTop,\n              behavior: \"smooth\"\n            });\n          }\n\n          navLinks.forEach(l => l.classList.remove(\"active\"));\n          this.classList.add(\"active\");\n        });\n      });\n\n      // ScrollSpy\n      const trackedSections = document.querySelectorAll(\"#doc-viewport section[id]\");\n      function initScrollSpy() {\n        const container = isDesktop() ? docViewport : appWorkspace;\n        const observer = new IntersectionObserver((entries) => {\n          entries.forEach(entry => {\n            if (entry.isIntersecting) {\n              const id = entry.target.getAttribute(\"id\");\n              navLinks.forEach(link => {\n                if (link.getAttribute(\"data-target\") === id) {\n                  link.classList.add(\"active\");\n                } else {\n                  link.classList.remove(\"active\");\n                }\n              });\n            }\n          });\n        }, {\n          root: container,\n          rootMargin: \"-10% 0px -70% 0px\",\n          threshold: 0\n        });\n\n        trackedSections.forEach(sec => observer.observe(sec));\n      }\n      initScrollSpy();\n      window.addEventListener(\"resize\", initScrollSpy);\n\n      // ==========================================\n      // 2. VS Code Style Sidebar Resizer\n      // ==========================================\n      const resizer = document.getElementById('drag-resizer');\n      const sidebar = document.getElementById('toc-panel');\n      let isResizing = false;\n\n      const resizerOverlay = document.createElement('div');\n      resizerOverlay.style.position = 'fixed';\n      resizerOverlay.style.inset = '0';\n      resizerOverlay.style.zIndex = '9999';\n      resizerOverlay.style.cursor = 'col-resize';\n      resizerOverlay.style.display = 'none';\n      document.body.appendChild(resizerOverlay);\n\n      resizer.addEventListener('mousedown', (e) => {\n        isResizing = true;\n        resizer.classList.add('dragging');\n        resizerOverlay.style.display = 'block';\n        document.body.style.userSelect = 'none';\n        e.preventDefault();\n      });\n\n      window.addEventListener('mousemove', (e) => {\n        if (!isResizing) return;\n        const workspaceRect = appWorkspace.getBoundingClientRect();\n        let newWidth = e.clientX - workspaceRect.left;\n\n        const minWidth = 220;\n        const maxWidth = workspaceRect.width * 0.55;\n\n        if (newWidth < minWidth) newWidth = minWidth;\n        if (newWidth > maxWidth) newWidth = maxWidth;\n\n        sidebar.style.width = `${newWidth}px`;\n      });\n\n      window.addEventListener('mouseup', () => {\n        if (isResizing) {\n          isResizing = false;\n          resizer.classList.remove('dragging');\n          resizerOverlay.style.display = 'none';\n          document.body.style.userSelect = '';\n        }\n      });\n\n      // ==========================================\n      // 3. Pin / Unpin & Floating Mode Logic\n      // ==========================================\n      let isPinned = true;\n      const masterCard = document.getElementById('master-video-card');\n      const dockAnchor = document.getElementById('video-dock-anchor');\n      const pinBtn = document.getElementById('pin-toggle-btn');\n      const dragHandleBar = document.getElementById('video-drag-handle-bar');\n      const dragShield = document.getElementById('drag-shield');\n\n      window.togglePinVideo = function(e) {\n        if (e) {\n          e.stopPropagation();\n          e.preventDefault();\n        }\n        isPinned = !isPinned;\n\n        if (isPinned) {\n          masterCard.classList.remove('video-floating-mode');\n          masterCard.classList.add('video-docked-box');\n          masterCard.style.top = '';\n          masterCard.style.left = '';\n          masterCard.style.right = '';\n          masterCard.style.bottom = '';\n\n          dockAnchor.appendChild(masterCard);\n          dragHandleBar.classList.add('hidden');\n          pinBtn.classList.remove('bg-amber-500', 'text-slate-950', 'border-amber-400');\n          pinBtn.classList.add('bg-slate-900/80', 'text-slate-200', 'border-slate-600');\n          pinBtn.innerHTML = `<i data-lucide=\"pin\" class=\"w-3.5 h-3.5 fill-current\"></i>`;\n        } else {\n          document.body.appendChild(masterCard);\n          masterCard.classList.remove('video-docked-box');\n          masterCard.classList.add('video-floating-mode');\n\n          masterCard.style.right = '24px';\n          masterCard.style.bottom = '24px';\n          masterCard.style.top = 'auto';\n          masterCard.style.left = 'auto';\n\n          dragHandleBar.classList.remove('hidden');\n          pinBtn.classList.remove('bg-slate-900/80', 'text-slate-200', 'border-slate-600');\n          pinBtn.classList.add('bg-amber-500', 'text-slate-950', 'border-amber-400');\n          pinBtn.innerHTML = `<i data-lucide=\"pin-off\" class=\"w-3.5 h-3.5\"></i>`;\n        }\n\n        lucide.createIcons();\n      };\n\n      // ==========================================\n      // 4. Floating Video Drag Logic\n      // ==========================================\n      let isDraggingVideo = false;\n      let startX, startY, initLeft, initTop;\n\n      function onDragStart(e) {\n        if (isPinned) return;\n        if (e.target.closest('#pin-toggle-btn')) return;\n\n        isDraggingVideo = true;\n        dragShield.classList.remove('hidden');\n\n        const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;\n        const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;\n\n        startX = clientX;\n        startY = clientY;\n\n        const rect = masterCard.getBoundingClientRect();\n        initLeft = rect.left;\n        initTop = rect.top;\n\n        masterCard.style.right = 'auto';\n        masterCard.style.bottom = 'auto';\n        masterCard.style.left = `${initLeft}px`;\n        masterCard.style.top = `${initTop}px`;\n\n        if (e.cancelable) e.preventDefault();\n      }\n\n      function onDragMove(e) {\n        if (!isDraggingVideo || isPinned) return;\n\n        const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;\n        const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;\n\n        const deltaX = clientX - startX;\n        const deltaY = clientY - startY;\n\n        let newX = initLeft + deltaX;\n        let newY = initTop + deltaY;\n\n        const cardW = masterCard.offsetWidth;\n        const cardH = masterCard.offsetHeight;\n        newX = Math.max(8, Math.min(newX, window.innerWidth - cardW - 8));\n        newY = Math.max(8, Math.min(newY, window.innerHeight - cardH - 8));\n\n        masterCard.style.left = `${newX}px`;\n        masterCard.style.top = `${newY}px`;\n      }\n\n      function onDragEnd() {\n        if (isDraggingVideo) {\n          isDraggingVideo = false;\n          dragShield.classList.add('hidden');\n        }\n      }\n\n      dragHandleBar.addEventListener('mousedown', onDragStart);\n      window.addEventListener('mousemove', onDragMove);\n      window.addEventListener('mouseup', onDragEnd);\n\n      dragHandleBar.addEventListener('touchstart', onDragStart, { passive: false });\n      window.addEventListener('touchmove', onDragMove, { passive: false });\n      window.addEventListener('touchend', onDragEnd);\n    });\n  </script>\n</body>\n</html>",
    "year": "২০২৩, ঢাকা বোর্ড"
  },
